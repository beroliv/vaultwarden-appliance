#!/usr/bin/env bash
# Vaultwarden Appliance vwctl

set -o errexit
set -o nounset
set -o pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
readonly SCRIPT_DIR
if [[ -f "${SCRIPT_DIR}/lib/common.sh" && ! -L "${SCRIPT_DIR}/lib/common.sh" ]]; then
    LIB_DIR="${SCRIPT_DIR}/lib"
else
    LIB_DIR="/usr/local/lib/vaultwarden-appliance"
fi
readonly LIB_DIR
for library in common network docker caddy mdns storage; do
    library_path="${LIB_DIR}/${library}.sh"
    if [[ ! -f "${library_path}" || -L "${library_path}" ]]; then
        printf 'Error: Required vwctl library is missing or unsafe: %s\n' "${library_path}" >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    . "${library_path}"
done
unset library library_path

readonly INSTALL_DIR="/opt/vaultwarden"
readonly APPLIANCE_MARKER="${INSTALL_DIR}/.vaultwarden-appliance"
readonly APPLIANCE_VERSION_FILE="${INSTALL_DIR}/.appliance-version"
readonly BASE_COMPOSE_FILE="${INSTALL_DIR}/docker-compose.yml"
readonly CADDY_COMPOSE_FILE="${INSTALL_DIR}/docker-compose.override.yml"
readonly VWCTL_COMPOSE_FILE="${INSTALL_DIR}/docker-compose.vwctl.yml"
readonly CADDYFILE="${INSTALL_DIR}/Caddyfile"
readonly ACCESS_FILE="${INSTALL_DIR}/.caddy-access"
readonly BACKUP_STATE_FILE="${INSTALL_DIR}/.backup-device"
readonly CADDY_ROOT_CA="${INSTALL_DIR}/data/caddy/data/caddy/pki/authorities/local/root.crt"
readonly EXPORTED_ROOT_CA="${INSTALL_DIR}/certs/caddy-root-ca.crt"
readonly APPLIANCE_NETWORK="vaultwarden-appliance"
readonly DEFAULT_MDNS_HOSTNAME="vaultwarden.local"
readonly MDNS_ENV_FILE="/etc/default/vaultwarden-appliance-mdns"
readonly MDNS_SERVICE_FILE="/etc/systemd/system/vaultwarden-appliance-mdns.service"
readonly MDNS_SERVICE="vaultwarden-appliance-mdns.service"
readonly MDNS_WRAPPER_FILE="/usr/local/libexec/vaultwarden-appliance-mdns"
readonly MDNS_READY_FILE="/run/vaultwarden-appliance-mdns/ready"
readonly LOG_LINES=100
readonly ACCESS_HTTPS_TIMEOUT=60
readonly ACCESS_HTTPS_RETRY_INTERVAL=2
readonly MIN_FREE_DISK_MB=2048
readonly OPERATION_LOCK="/run/lock/vaultwarden-appliance.lock"
if [[ -f "${SCRIPT_DIR}/libexec/usb-setup" && ! -L "${SCRIPT_DIR}/libexec/usb-setup" ]]; then
    USB_SETUP_HELPER="${SCRIPT_DIR}/libexec/usb-setup"
else
    USB_SETUP_HELPER="/usr/local/libexec/vaultwarden-appliance-usb-setup"
fi
readonly USB_SETUP_HELPER

ACCESS_ADDRESS=""
HTTPS_LAST_ERROR=""
HEALTH_FAILURES=0
UPDATE_CHECK_AVAILABLE=0
UPDATE_CHECK_UNDETERMINED=0
USB_TOPOLOGY=""
USB_SYSTEM_MOUNTS=""
USB_PROTECTED_DISKS=""
USB_CANDIDATES=()

info() {
    printf '%s\n' "$*"
}

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

