require_appliance() {
    [[ -d "${INSTALL_DIR}" ]] || die "Vaultwarden Appliance is not installed at ${INSTALL_DIR}."
    [[ -f "${APPLIANCE_MARKER}" && ! -L "${APPLIANCE_MARKER}" ]] || \
        die "${INSTALL_DIR} is not a recognized Vaultwarden Appliance installation."
    [[ -f "${BASE_COMPOSE_FILE}" && ! -L "${BASE_COMPOSE_FILE}" ]] || \
        die "The appliance Compose file is missing or unsafe."
    [[ -f "${CADDY_COMPOSE_FILE}" && ! -L "${CADDY_COMPOSE_FILE}" ]] || \
        die "The appliance Caddy Compose file is missing or unsafe."
    [[ -f "${CADDYFILE}" && ! -L "${CADDYFILE}" ]] || \
        die "The appliance Caddyfile is missing or unsafe."
}

require_root() {
    local command_text=$1

    if (( EUID != 0 )); then
        printf 'This operation requires root privileges.\n' >&2
        printf 'Run:\n' >&2
        printf 'sudo vwctl %s\n' "${command_text}" >&2
        exit 1
    fi
}

require_operation_lock() {
    local result=0

    if acquire_appliance_lock "${OPERATION_LOCK}"; then
        return 0
    else
        result=$?
    fi
    case "${result}" in
        1) die "Another Vaultwarden Appliance operation is already running." ;;
        2) die "flock is required for mutating appliance operations. Rerun the installer." ;;
        *) die "Unable to create the root-owned appliance operation lock at ${OPERATION_LOCK}." ;;
    esac
}

require_docker() {
    command_exists docker || die "Docker is not installed."
    docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is unavailable as 'docker compose'."
    docker info >/dev/null 2>&1 || \
        die "The Docker daemon is unavailable. Use sudo or a user with Docker access."
}

compose() {
    local -a compose_args

    compose_args=(
        --project-directory "${INSTALL_DIR}"
        -f "${BASE_COMPOSE_FILE}"
        -f "${CADDY_COMPOSE_FILE}"
    )
    if [[ -e "${VWCTL_COMPOSE_FILE}" ]]; then
        [[ -f "${VWCTL_COMPOSE_FILE}" && ! -L "${VWCTL_COMPOSE_FILE}" ]] || \
            die "The managed Vaultwarden Compose path is not a safe regular file."
        compose_args+=(-f "${VWCTL_COMPOSE_FILE}")
    fi

    docker compose "${compose_args[@]}" "$@"
}

compose_with_vaultwarden_candidate() {
    local candidate=$1
    shift

    docker compose \
        --project-directory "${INSTALL_DIR}" \
        -f "${BASE_COMPOSE_FILE}" \
        -f "${CADDY_COMPOSE_FILE}" \
        -f "${candidate}" \
        "$@"
}

require_mdns_runtime() {
    command_exists avahi-resolve-host-name || die "avahi-utils is required. Rerun the appliance installer."
    command_exists avahi-publish-address || die "avahi-utils is required. Rerun the appliance installer."
    command_exists systemctl || die "systemd is required for appliance mDNS."
    [[ -f "${MDNS_ENV_FILE}" && ! -L "${MDNS_ENV_FILE}" ]] || \
        die "The appliance mDNS state is missing or unsafe. Rerun the appliance installer."
    [[ -f "${MDNS_SERVICE_FILE}" && ! -L "${MDNS_SERVICE_FILE}" ]] || \
        die "The appliance mDNS service is missing or unsafe. Rerun the appliance installer."
    grep -Fxq '# Vaultwarden Appliance mDNS' "${MDNS_ENV_FILE}" || \
        die "The mDNS state is not appliance-managed."
    grep -Fxq '# Vaultwarden Appliance mDNS' "${MDNS_SERVICE_FILE}" || \
        die "The mDNS service is not appliance-managed."
    [[ -f "${MDNS_WRAPPER_FILE}" && ! -L "${MDNS_WRAPPER_FILE}" ]] || \
        die "The appliance mDNS publisher wrapper is missing or unsafe. Rerun the appliance installer."
    grep -Fxq '# Vaultwarden Appliance mDNS publisher' "${MDNS_WRAPPER_FILE}" || \
        die "The mDNS publisher wrapper is not appliance-managed."
    grep -Fq 'ExecStart=/usr/local/libexec/vaultwarden-appliance-mdns' "${MDNS_SERVICE_FILE}" || \
        die "The appliance mDNS service is obsolete. Rerun the appliance installer."
}

mdns_name_conflicts() {
    local hostname=$1
    local address
    local current_ip=""
    local local_addresses=""
    local resolved=""

    current_ip=$(detect_ipv4_address || true)
    resolved=$(mdns_resolved_ipv4s "${hostname}" || true)
    [[ -n "${resolved}" ]] || return 1
    local_addresses=$(local_ipv4_addresses || true)

    while IFS= read -r address; do
        [[ -n "${current_ip}" && "${address}" == "${current_ip}" ]] && continue
        grep -Fxq "${address}" <<<"${local_addresses}" && continue
        return 0
    done <<<"${resolved}"
    return 1
}

next_available_mdns_hostname() {
    local base=${1%.local}
    local candidate
    local suffix

    for suffix in {2..99}; do
        candidate="${base}-${suffix}.local"
        if validate_local_hostname "${candidate}" && ! mdns_name_conflicts "${candidate}"; then
            printf '%s\n' "${candidate}"
            return 0
        fi
    done
    return 1
}

configure_mdns_hostname() {
    local hostname=$1
    local candidate
    local current_ip

    require_mdns_runtime
    current_ip=$(detect_ipv4_address) || \
        die "Unable to detect the LAN IPv4 address for the mDNS publication."
    candidate=$(mktemp "${INSTALL_DIR}/.mdns-env.vwctl.XXXXXXXX") || \
        die "Unable to create a temporary mDNS state file."
    printf '# Vaultwarden Appliance mDNS\nVAULTWARDEN_MDNS_HOSTNAME=%s\nVAULTWARDEN_MDNS_IPV4=%s\n' \
        "${hostname}" "${current_ip}" > "${candidate}"
    chmod 0644 "${candidate}"
    if ! install -m 0644 "${candidate}" "${MDNS_ENV_FILE}"; then
        rm -f -- "${candidate}"
        die "Unable to update the appliance mDNS hostname state."
    fi
    rm -f -- "${candidate}"

    systemctl restart "${MDNS_SERVICE}" || die "Unable to restart the appliance mDNS hostname service."
}

show_mdns_service_logs() {
    printf 'Recent %s log:\n' "${MDNS_SERVICE}" >&2
    if command_exists journalctl; then
        journalctl --unit "${MDNS_SERVICE}" --no-pager --lines 30 >&2 || true
    else
        systemctl status "${MDNS_SERVICE}" --no-pager >&2 || true
    fi
}

mdns_service_is_ready() {
    local hostname=$1
    local current_ip=$2

    mdns_ready_file_matches "${MDNS_READY_FILE}" "${hostname}" "${current_ip}"
}

verify_mdns_hostname() {
    local hostname=$1
    local current_ip
    local deadline=$((SECONDS + ACCESS_HTTPS_TIMEOUT))
    local getent_resolved=""
    local resolved=""

    current_ip=$(detect_ipv4_address) || {
        printf '[FAIL] Unable to detect the LAN IPv4 address for mDNS verification.\n' >&2
        return 1
    }
    if ! systemctl is-active --quiet avahi-daemon.service; then
        printf '[FAIL] Avahi is not active.\n' >&2
        return 1
    fi
    while :; do
        resolved=$(mdns_resolved_ipv4s "${hostname}" || true)
        if systemctl is-active --quiet "${MDNS_SERVICE}" &&
           mdns_service_is_ready "${hostname}" "${current_ip}" &&
           mdns_resolution_matches "${current_ip}" "${resolved}"; then
            if command_exists getent; then
                getent_resolved=$(timeout 4 getent hosts "${hostname}" 2>/dev/null |
                    awk '$1 ~ /^[0-9]+(\.[0-9]+){3}$/ && !seen[$1]++ {print $1}' || true)
                if ! mdns_resolution_matches "${current_ip}" "${getent_resolved}"; then
                    printf '[WARN] System host lookup does not yet resolve %s exclusively to %s; Avahi-specific resolution is correct.\n' \
                        "${hostname}" "${current_ip}" >&2
                    [[ -z "${getent_resolved}" ]] || \
                        printf 'getent IPv4 address(es): %s\n' "${getent_resolved//$'\n'/, }" >&2
                fi
            fi
            return 0
        fi
        (( SECONDS >= deadline )) && break
        sleep "${ACCESS_HTTPS_RETRY_INTERVAL}"
    done

    if ! systemctl is-active --quiet "${MDNS_SERVICE}"; then
        printf '[FAIL] The appliance mDNS publisher service is not active.\n' >&2
    elif ! mdns_service_is_ready "${hostname}" "${current_ip}"; then
        printf '[FAIL] The appliance mDNS publisher did not confirm that the explicit mapping is active.\n' >&2
    fi
    printf '[FAIL] mDNS did not resolve %s exclusively to the detected LAN IPv4 address %s.\n' \
        "${hostname}" "${current_ip}" >&2
    [[ -z "${resolved}" ]] || printf 'Resolved IPv4 address(es): %s\n' "${resolved//$'\n'/, }" >&2
    show_mdns_service_logs
    return 1
}

load_access_state() {
    ACCESS_ADDRESS=$(read_access_hostname "${ACCESS_FILE}") || return 1
}

write_access_state_to() {
    local destination=$1
    local address=$2

    printf 'hostname=%s\n' "${address}" > "${destination}"
    chmod 0644 "${destination}"
}

container_state() {
    local container=$1
    local state

    state=$(docker inspect --format '{{.State.Status}}' "${container}" 2>/dev/null) || state="not found"
    printf '%s\n' "${state}"
}

container_image() {
    local container=$1
    local image

    image=$(docker inspect --format '{{.Config.Image}}' "${container}" 2>/dev/null) || image="unavailable"
    printf '%s\n' "${image}"
}

configured_service_image() {
    local service=$1
    local image=""

    image=$(docker inspect --format '{{.Config.Image}}' "${service}" 2>/dev/null || true)
    if [[ -n "${image}" ]]; then
        printf '%s\n' "${image}"
        return 0
    fi

    compose config 2>/dev/null | awk -v service="${service}" '
        $0 == "  " service ":" {in_service=1; next}
        in_service && $0 ~ /^  [^ ]/ {exit}
        in_service && $1 == "image:" {print $2; exit}
    '
}

container_repo_digests() {
    local container=$1
    local image_id

    image_id=$(docker inspect --format '{{.Image}}' "${container}" 2>/dev/null) || return 1
    docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "${image_id}" 2>/dev/null |
        awk -F@ 'NF == 2 && $2 ~ /^sha256:/ && !seen[$2]++ {print $2}'
}

remote_image_digest() {
    local image=$1
    local output

    output=$(docker buildx imagetools inspect "${image}" 2>/dev/null) || return 1
    awk '$1 == "Digest:" && $2 ~ /^sha256:/ {print $2; exit}' <<<"${output}"
}

caddy_publishes_only_https() {
    [[ "$(docker inspect --format '{{len .HostConfig.PortBindings}}' caddy 2>/dev/null)" == "1" ]] || return 1
    docker inspect --format '{{with (index .HostConfig.PortBindings "443/tcp")}}{{range .}}{{println .HostPort}}{{end}}{{end}}' \
        caddy 2>/dev/null | grep -Fxq 443
}

wait_for_port() {
    local port=$1
    local timeout_seconds=$2
    local retry_interval=$3
    local deadline=$((SECONDS + timeout_seconds))

    while :; do
        port_is_in_use "${port}" && return 0
        if (( SECONDS >= deadline )); then
            break
        fi
        sleep "${retry_interval}"
    done
    return 1
}

current_signup_value() {
    local value

    value=$(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' vaultwarden 2>/dev/null |
        awk -F= '$1 == "SIGNUPS_ALLOWED" {print tolower(substr($0, index($0, "=") + 1)); exit}') || true

    if [[ -z "${value}" ]]; then
        value=$(compose config 2>/dev/null |
            awk '$1 == "SIGNUPS_ALLOWED:" {gsub(/"/, "", $2); print tolower($2); exit}') || true
    fi

    case "${value}" in
        true|1|yes)
            printf 'true\n'
            ;;
        false|0|no)
            printf 'false\n'
            ;;
        *)
            printf 'unknown\n'
            ;;
    esac
}

wait_for_container() {
    local container=$1
    local _attempt

    for _attempt in {1..30}; do
        if [[ "$(docker inspect --format '{{.State.Running}}' "${container}" 2>/dev/null)" == "true" ]]; then
            return 0
        fi
        sleep 1
    done
    return 1
}

verify_https() {
    local address=$1
    local timeout_seconds=${2:-30}
    local retry_interval=${3:-1}
    local deadline

    command_exists curl || return 1
    [[ -f "${EXPORTED_ROOT_CA}" && ! -L "${EXPORTED_ROOT_CA}" ]] || return 1

    HTTPS_LAST_ERROR=""
    deadline=$((SECONDS + timeout_seconds))

    while :; do
        if HTTPS_LAST_ERROR=$(curl --fail --silent --show-error \
            --connect-timeout 3 \
            --max-time 5 \
            --noproxy '*' \
            --cacert "${EXPORTED_ROOT_CA}" \
            --connect-to "${address}:443:127.0.0.1:443" \
            --output /dev/null \
            "https://${address}/alive" 2>&1); then
            HTTPS_LAST_ERROR=""
            return 0
        fi

        if (( SECONDS >= deadline )); then
            break
        fi
        sleep "${retry_interval}"
    done
    return 1
}

root_ca_hash() {
    [[ -f "${CADDY_ROOT_CA}" && ! -L "${CADDY_ROOT_CA}" ]] || return 1
    sha256sum -- "${CADDY_ROOT_CA}" | awk 'NR == 1 {print $1}'
}

root_ca_matches_hash() {
    local expected_hash=$1
    local current_hash

    current_hash=$(root_ca_hash) || return 1
    [[ "${current_hash}" == "${expected_hash}" ]]
}

refresh_root_ca_export() {
    local cert_dir="${INSTALL_DIR}/certs"

    [[ -f "${CADDY_ROOT_CA}" && ! -L "${CADDY_ROOT_CA}" ]] || return 1
    if [[ -e "${cert_dir}" && ( ! -d "${cert_dir}" || -L "${cert_dir}" ) ]]; then
        return 1
    fi
    if [[ -e "${EXPORTED_ROOT_CA}" && \
          ( ! -f "${EXPORTED_ROOT_CA}" || -L "${EXPORTED_ROOT_CA}" ) ]]; then
        return 1
    fi

    install -d -m 0755 "${cert_dir}" || return 1
    copy_public_certificate_atomic "${CADDY_ROOT_CA}" "${EXPORTED_ROOT_CA}" || return 1
    cmp -s "${CADDY_ROOT_CA}" "${EXPORTED_ROOT_CA}"
}

show_caddy_failure_context() {
    printf 'Caddy container state:\n' >&2
    docker inspect --format '{{json .State}}' caddy >&2 || true
    printf 'Recent Caddy logs:\n' >&2
    docker logs --tail 30 caddy >&2 || true
}

verify_access_change() {
    local address=$1
    local expected_root_hash=$2

    if ! wait_for_container caddy; then
        printf '[FAIL] Caddy container did not become ready.\n' >&2
        show_caddy_failure_context
        return 1
    fi

    if ! container_is_connected_to_network caddy "${APPLIANCE_NETWORK}"; then
        printf '[FAIL] Caddy is not attached to %s.\n' "${APPLIANCE_NETWORK}" >&2
        docker inspect --format '{{json .NetworkSettings.Networks}}' caddy >&2 || true
        return 1
    fi

    if ! caddy_publishes_only_https; then
        printf '[FAIL] Caddy is not publishing only TCP port 443.\n' >&2
        docker inspect --format '{{json .HostConfig.PortBindings}}' caddy >&2 || true
        return 1
    fi

    if ! wait_for_container vaultwarden; then
        printf '[FAIL] Vaultwarden is not running after the Caddy rebuild.\n' >&2
        return 1
    fi

    if ! vaultwarden_domain_matches "${address}"; then
        printf '[FAIL] Vaultwarden DOMAIN does not match https://%s.\n' "${address}" >&2
        docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' vaultwarden 2>/dev/null |
            grep '^DOMAIN=' >&2 || true
        return 1
    fi

    if ! container_is_connected_to_network vaultwarden "${APPLIANCE_NETWORK}"; then
        printf '[FAIL] Vaultwarden is not attached to %s.\n' "${APPLIANCE_NETWORK}" >&2
        docker inspect --format '{{json .NetworkSettings.Networks}}' vaultwarden >&2 || true
        return 1
    fi

    if [[ "$(docker inspect --format '{{len .HostConfig.PortBindings}}' vaultwarden 2>/dev/null)" != "0" ]]; then
        printf '[FAIL] Vaultwarden unexpectedly publishes a host port.\n' >&2
        docker inspect --format '{{json .HostConfig.PortBindings}}' vaultwarden >&2 || true
        return 1
    fi

    if ! wait_for_port \
        443 \
        "${ACCESS_HTTPS_TIMEOUT}" \
        "${ACCESS_HTTPS_RETRY_INTERVAL}"; then
        printf '[FAIL] TCP port 443 is not listening.\n' >&2
        return 1
    fi

    if ! verify_mdns_hostname "${address}"; then
        return 1
    fi

    if ! root_ca_matches_hash "${expected_root_hash}"; then
        printf '[FAIL] Caddy root CA changed unexpectedly.\n' >&2
        return 1
    fi

    if ! refresh_root_ca_export ||
       ! cmp -s "${CADDY_ROOT_CA}" "${EXPORTED_ROOT_CA}"; then
        printf '[FAIL] The public Caddy root CA export could not be refreshed and verified.\n' >&2
        return 1
    fi

    if ! verify_https \
        "${address}" \
        "${ACCESS_HTTPS_TIMEOUT}" \
        "${ACCESS_HTTPS_RETRY_INTERVAL}"; then
        printf '[FAIL] HTTPS verification failed for https://%s/alive.\n' "${address}" >&2
        if [[ -n "${HTTPS_LAST_ERROR}" ]]; then
            printf 'Last curl error: %s\n' "${HTTPS_LAST_ERROR}" >&2
        fi
        printf 'Recent Caddy logs:\n' >&2
        docker logs --tail 30 caddy >&2 || true
        return 1
    fi

    if ! root_ca_matches_hash "${expected_root_hash}"; then
        printf '[FAIL] Caddy root CA changed unexpectedly.\n' >&2
        return 1
    fi
}

require_https_verification_ready() {
    command_exists curl || die "curl is required for HTTPS verification."
    [[ -f "${CADDY_ROOT_CA}" && ! -L "${CADDY_ROOT_CA}" ]] || \
        die "Caddy's public root CA is missing."
    [[ -f "${EXPORTED_ROOT_CA}" && ! -L "${EXPORTED_ROOT_CA}" ]] || \
        die "The exported root CA is missing. Run: sudo vwctl cert export"
    cmp -s "${CADDY_ROOT_CA}" "${EXPORTED_ROOT_CA}" || \
        die "The root CA export does not match Caddy's persistent public root certificate."
}

verify_root_ca_unchanged() {
    local saved_root=$1

    [[ -f "${CADDY_ROOT_CA}" && ! -L "${CADDY_ROOT_CA}" ]] || return 1
    [[ -f "${EXPORTED_ROOT_CA}" && ! -L "${EXPORTED_ROOT_CA}" ]] || return 1
    cmp -s "${saved_root}" "${CADDY_ROOT_CA}" &&
        cmp -s "${CADDY_ROOT_CA}" "${EXPORTED_ROOT_CA}"
}

verify_appliance() {
    if ! load_access_state; then
        printf 'Error: The appliance access state is invalid.\n' >&2
        return 1
    fi
    if ! wait_for_container vaultwarden; then
        printf 'Error: Vaultwarden is not running after the operation.\n' >&2
        return 1
    fi
    if ! wait_for_container caddy; then
        printf 'Error: Caddy is not running after the operation.\n' >&2
        return 1
    fi
    if ! vaultwarden_domain_matches "${ACCESS_ADDRESS}"; then
        printf 'Error: The running Vaultwarden DOMAIN does not match https://%s.\n' "${ACCESS_ADDRESS}" >&2
        return 1
    fi

    if [[ "$(docker inspect --format '{{len .HostConfig.PortBindings}}' vaultwarden 2>/dev/null)" != "0" ]]; then
        printf 'Error: Vaultwarden unexpectedly publishes a host port.\n' >&2
        return 1
    fi
    if ! caddy_publishes_only_https; then
        printf 'Error: Caddy must publish only host TCP port 443.\n' >&2
        return 1
    fi
    if ! container_is_connected_to_network vaultwarden "${APPLIANCE_NETWORK}"; then
        printf 'Error: Vaultwarden is not connected to %s.\n' "${APPLIANCE_NETWORK}" >&2
        return 1
    fi
    if ! container_is_connected_to_network caddy "${APPLIANCE_NETWORK}"; then
        printf 'Error: Caddy is not connected to %s.\n' "${APPLIANCE_NETWORK}" >&2
        return 1
    fi
    if ! verify_mdns_hostname "${ACCESS_ADDRESS}"; then
        return 1
    fi
    if ! verify_https "${ACCESS_ADDRESS}"; then
        printf 'Error: HTTPS verification failed for https://%s.\n' "${ACCESS_ADDRESS}" >&2
        return 1
    fi
}

create_operation_directory() {
    local directory

    directory=$(mktemp -d /tmp/vwctl.XXXXXXXX) || die "Unable to create a temporary operation directory."
    [[ "${directory}" == /tmp/vwctl.* && -d "${directory}" ]] || \
        die "Temporary operation directory validation failed."
    printf '%s\n' "${directory}"
}

cleanup_operation_directory() {
    local directory=$1

    [[ "${directory}" == /tmp/vwctl.* && -d "${directory}" ]] || return 1
    rm -f -- \
        "${directory}/root-ca" \
        "${directory}/signup-compose"
    rmdir -- "${directory}"
}

health_ok() {
    printf '[ OK ] %s\n' "$1"
}

health_fail() {
    local check=$1
    local reason=$2

    printf '[FAIL] %s: %s\n' "${check}" "${reason}" >&2
    HEALTH_FAILURES=$((HEALTH_FAILURES + 1))
}

root_ca_export_matches_caddy() {
    [[ -f "${EXPORTED_ROOT_CA}" && ! -L "${EXPORTED_ROOT_CA}" ]] || return 1
    container_is_running caddy || return 1
    docker exec caddy cat /data/caddy/pki/authorities/local/root.crt 2>/dev/null |
        cmp -s - "${EXPORTED_ROOT_CA}"
}

command_health() {
    local available_kb=""
    local available_mb=0
    local current_ip=""
    local docker_ready=0
    local mdns_ready=0
    local resolved=""

    require_appliance
    HEALTH_FAILURES=0
    printf 'Vaultwarden Appliance health\n\n'

    if command_exists docker &&
       docker compose version >/dev/null 2>&1 &&
       docker info >/dev/null 2>&1; then
        docker_ready=1
        health_ok "Docker"
    else
        health_fail "Docker" "daemon or Docker Compose v2 is not accessible"
    fi

    if (( docker_ready == 1 )) &&
       container_exists vaultwarden &&
       container_is_running vaultwarden &&
       [[ "$(docker inspect --format '{{len .HostConfig.PortBindings}}' vaultwarden 2>/dev/null)" == "0" ]] &&
       container_is_connected_to_network vaultwarden "${APPLIANCE_NETWORK}" &&
       load_access_state &&
       vaultwarden_domain_matches "${ACCESS_ADDRESS}"; then
        health_ok "Vaultwarden"
    else
        health_fail "Vaultwarden" "container/runtime DOMAIN is wrong, missing, stopped, publishing a host port, or disconnected from ${APPLIANCE_NETWORK}"
    fi

    if (( docker_ready == 1 )) &&
       container_exists caddy &&
       container_is_running caddy &&
       caddy_publishes_only_https &&
       container_is_connected_to_network caddy "${APPLIANCE_NETWORK}"; then
        health_ok "Caddy"
    else
        health_fail "Caddy" "container is missing, stopped, not publishing only TCP 443, or disconnected from ${APPLIANCE_NETWORK}"
    fi

    if load_access_state &&
       current_ip=$(detect_ipv4_address) &&
       command_exists systemctl &&
       command_exists avahi-resolve-host-name &&
       systemctl is-active --quiet avahi-daemon.service &&
       systemctl is-active --quiet "${MDNS_SERVICE}" &&
       mdns_service_is_ready "${ACCESS_ADDRESS}" "${current_ip}"; then
        resolved=$(mdns_resolved_ipv4s "${ACCESS_ADDRESS}" || true)
        if mdns_resolution_matches "${current_ip}" "${resolved}"; then
            mdns_ready=1
            health_ok "mDNS"
        else
            health_fail "mDNS" "${ACCESS_ADDRESS} does not resolve exclusively to ${current_ip}"
        fi
    else
        health_fail "mDNS" "Avahi, publisher state, access state, or LAN IPv4 verification failed"
    fi

    if (( docker_ready == 1 && mdns_ready == 1 )) &&
       command_exists curl &&
       verify_https "${ACCESS_ADDRESS}" 10 2; then
        health_ok "HTTPS"
    else
        health_fail "HTTPS" "https://${ACCESS_ADDRESS:-unknown}/alive did not validate with the exported root CA"
    fi

    if (( docker_ready == 1 )) && root_ca_export_matches_caddy; then
        health_ok "Root CA"
    else
        health_fail "Root CA" "the readable export is missing or does not match Caddy's persistent public root certificate"
    fi

    if ! available_kb=$(df -Pk "${INSTALL_DIR}" 2>/dev/null | awk 'NR == 2 {print $4}'); then
        available_kb=""
    fi
    if [[ -d "${INSTALL_DIR}/data/vaultwarden" &&
          -d "${INSTALL_DIR}/data/caddy" &&
          "${available_kb}" =~ ^[0-9]+$ ]]; then
        available_mb=$((available_kb / 1024))
        if (( available_mb >= MIN_FREE_DISK_MB )); then
            health_ok "Storage (${available_mb} MiB free)"
        else
            health_fail "Storage" "only ${available_mb} MiB free; ${MIN_FREE_DISK_MB} MiB is required"
        fi
    else
        health_fail "Storage" "persistent data directories or disk-space information are unavailable"
    fi

    if (( HEALTH_FAILURES == 0 )); then
        printf '\nHealth check: OK\n'
        return 0
    fi

    printf '\nHealth check: FAILED (%d check(s))\n' "${HEALTH_FAILURES}" >&2
    return 1
}

command_status() {
    local caddy_state
    local current_ip="not detected"
    local mdns_name
    local mdns_state="inactive"
    local network_state="incomplete"
    local resolved_ip="not resolved"
    local root_state="missing"
    local signup_label
    local vaultwarden_state

    require_appliance
    require_docker
    load_access_state || die "The appliance access state is missing or invalid."

    vaultwarden_state=$(container_state vaultwarden)
    caddy_state=$(container_state caddy)
    current_ip=$(detect_ipv4_address || printf 'not detected')

    mdns_name=${ACCESS_ADDRESS}
    if command_exists systemctl &&
       systemctl is-active --quiet avahi-daemon.service &&
       systemctl is-active --quiet "${MDNS_SERVICE}"; then
        mdns_state="active"
    fi
    if command_exists avahi-resolve-host-name; then
        resolved_ip=$(mdns_resolved_ipv4s "${ACCESS_ADDRESS}" || true)
        [[ -n "${resolved_ip}" ]] || resolved_ip="not resolved"
        resolved_ip=${resolved_ip//$'\n'/, }
    fi

    if container_is_connected_to_network vaultwarden "${APPLIANCE_NETWORK}" &&
       container_is_connected_to_network caddy "${APPLIANCE_NETWORK}"; then
        network_state="connected"
    fi

    if [[ -f "${EXPORTED_ROOT_CA}" && ! -L "${EXPORTED_ROOT_CA}" ]]; then
        root_state="present"
    fi

    case "$(current_signup_value)" in
        true) signup_label="enabled" ;;
        false) signup_label="disabled" ;;
        *) signup_label="unknown" ;;
    esac

    printf 'Vaultwarden Appliance status\n\n'
    printf '%-15s %s\n' 'Vaultwarden:' "${vaultwarden_state}"
    printf '%-15s %s\n' 'Caddy:' "${caddy_state}"
    printf '%-15s https://%s\n' 'URL:' "${ACCESS_ADDRESS}"
    printf '%-15s %s\n' 'mDNS:' "${mdns_state}"
    printf '%-15s %s\n' 'mDNS name:' "${mdns_name}"
    printf '%-15s %s\n' 'Resolved IP:' "${resolved_ip}"
    printf '%-15s %s\n' 'Current IP:' "${current_ip}"
    printf '%-15s %s\n' 'Network:' "${network_state} (${APPLIANCE_NETWORK})"
    printf '%-15s %s\n' 'VW image:' "$(container_image vaultwarden)"
    printf '%-15s %s\n' 'Caddy image:' "$(container_image caddy)"
    printf '%-15s %s\n' 'Signup:' "${signup_label}"
    printf '%-15s %s\n' 'Root CA:' "${EXPORTED_ROOT_CA}"
    printf '%-15s %s\n' 'CA export:' "${root_state}"
}

command_logs() {
    local service=${1:-}

    require_appliance
    require_docker

    case "${service}" in
        "")
            compose logs --tail "${LOG_LINES}" vaultwarden caddy
            ;;
        vaultwarden|caddy)
            compose logs --tail "${LOG_LINES}" "${service}"
            ;;
        *)
            die "Usage: vwctl logs [vaultwarden|caddy]"
            ;;
    esac
}

command_start() {
    local already_running=0

    require_root "start"
    require_operation_lock
    require_appliance
    require_docker
    load_access_state || die "The appliance access state is missing or invalid."
    require_mdns_runtime
    require_https_verification_ready
    compose config --quiet || die "The appliance Compose configuration is invalid."

    if container_is_running vaultwarden &&
       container_is_running caddy &&
       systemctl is-active --quiet "${MDNS_SERVICE}"; then
        already_running=1
        info "Vaultwarden, Caddy, and the mDNS publisher are already running."
    else
        info "Starting Vaultwarden and Caddy without recreating existing containers..."
        compose up -d --no-recreate vaultwarden caddy || \
            die "Docker Compose could not start the appliance containers."
        systemctl start "${MDNS_SERVICE}" || \
            die "The appliance mDNS publisher could not be started."
    fi

    verify_appliance || die "Started appliance verification failed."
    if (( already_running == 1 )); then
        info "Appliance services were already running and are healthy."
    else
        info "Appliance services started and verified."
    fi
    info "URL: https://${ACCESS_ADDRESS}"
}

command_stop() {
    local already_stopped=0

    require_root "stop"
    require_operation_lock
    require_appliance
    require_docker
    require_mdns_runtime
    compose config --quiet || die "The appliance Compose configuration is invalid."

    if ! container_is_running vaultwarden &&
       ! container_is_running caddy &&
       ! systemctl is-active --quiet "${MDNS_SERVICE}"; then
        already_stopped=1
        info "Vaultwarden, Caddy, and the mDNS publisher are already stopped."
    else
        info "Stopping the appliance mDNS advertisement..."
        systemctl stop "${MDNS_SERVICE}" || \
            die "The appliance mDNS publisher could not be stopped."
        info "Stopping Caddy and Vaultwarden without removing containers..."
        compose stop caddy vaultwarden || \
            die "Docker Compose could not stop the appliance containers."
    fi

    if container_is_running vaultwarden || container_is_running caddy; then
        die "One or more appliance containers are still running."
    fi
    if systemctl is-active --quiet "${MDNS_SERVICE}"; then
        die "The appliance mDNS publisher is still active."
    fi

    if (( already_stopped == 1 )); then
        info "No changes were needed."
    else
        info "Vaultwarden, Caddy, and the mDNS publisher are stopped."
    fi
    info "Containers, Docker network, persistent data, and Caddy CA data were preserved."
    info "Avahi remains running for unrelated services."
}

command_version() {
    local appliance_version="unavailable"
    local caddy_image="unavailable"
    local caddy_version=""
    local compose_version="unavailable"
    local docker_version="unavailable"
    local vaultwarden_image="unavailable"
    local vaultwarden_version=""
    local -a version_lines

    require_appliance

    if [[ -f "${APPLIANCE_VERSION_FILE}" && ! -L "${APPLIANCE_VERSION_FILE}" ]]; then
        mapfile -t version_lines < "${APPLIANCE_VERSION_FILE}"
        if (( ${#version_lines[@]} == 1 )); then
            appliance_version=${version_lines[0]}
        fi
    fi

    if command_exists docker; then
        docker_version=$(docker --version 2>/dev/null || printf 'unavailable')
        compose_version=$(docker compose version --short 2>/dev/null || printf 'unavailable')
        if docker info >/dev/null 2>&1; then
            vaultwarden_image=$(configured_service_image vaultwarden || printf 'unavailable')
            caddy_image=$(configured_service_image caddy || printf 'unavailable')
            if container_is_running vaultwarden; then
                vaultwarden_version=$(docker exec vaultwarden /vaultwarden --version 2>/dev/null |
                    awk 'NF {print; exit}' || true)
            fi
            if container_is_running caddy; then
                caddy_version=$(docker exec caddy caddy version 2>/dev/null |
                    awk 'NF {print; exit}' || true)
            fi
        fi
    fi

    [[ -n "${vaultwarden_version}" ]] || vaultwarden_version=${vaultwarden_image:-unavailable}
    [[ -n "${caddy_version}" ]] || caddy_version=${caddy_image:-unavailable}

    printf '%-23s %s\n' 'Vaultwarden Appliance:' "${appliance_version}"
    printf '%-23s %s\n' 'Vaultwarden:' "${vaultwarden_version}"
    printf '%-23s %s\n' 'Caddy:' "${caddy_version}"
    printf '%-23s %s\n' 'Docker:' "${docker_version}"
    printf '%-23s %s\n' 'Docker Compose:' "${compose_version}"
}

check_service_update() {
    local label=$1
    local service=$2
    local image
    local local_digests
    local remote_digest

    image=$(configured_service_image "${service}" || true)
    if [[ -z "${image}" ]]; then
        printf '[WARN] %s: unable to determine the configured image\n' "${label}"
        UPDATE_CHECK_UNDETERMINED=$((UPDATE_CHECK_UNDETERMINED + 1))
        return
    fi

    local_digests=$(container_repo_digests "${service}" || true)
    if [[ -z "${local_digests}" ]]; then
        printf '[WARN] %s: unable to determine the running image digest (%s)\n' "${label}" "${image}"
        UPDATE_CHECK_UNDETERMINED=$((UPDATE_CHECK_UNDETERMINED + 1))
        return
    fi

    remote_digest=$(remote_image_digest "${image}" || true)
    if [[ -z "${remote_digest}" ]]; then
        printf '[WARN] %s: unable to retrieve remote image metadata (%s)\n' "${label}" "${image}"
        UPDATE_CHECK_UNDETERMINED=$((UPDATE_CHECK_UNDETERMINED + 1))
        return
    fi

    if grep -Fxq "${remote_digest}" <<<"${local_digests}"; then
        printf '[ OK ] %s: up to date (%s)\n' "${label}" "${image}"
    else
        printf '[UPDATE] %s: update available (%s)\n' "${label}" "${image}"
        printf '         local:  %s\n' "$(head -n 1 <<<"${local_digests}")"
        printf '         remote: %s\n' "${remote_digest}"
        UPDATE_CHECK_AVAILABLE=$((UPDATE_CHECK_AVAILABLE + 1))
    fi
}

command_update_check() {
    require_appliance
    require_docker

    printf 'Vaultwarden Appliance update check\n\n'
    if ! docker buildx version >/dev/null 2>&1; then
        printf '[WARN] Docker Buildx is unavailable; remote image metadata cannot be inspected.\n' >&2
        return 1
    fi

    UPDATE_CHECK_AVAILABLE=0
    UPDATE_CHECK_UNDETERMINED=0
    check_service_update "Vaultwarden" vaultwarden
    check_service_update "Caddy" caddy

    if (( UPDATE_CHECK_UNDETERMINED > 0 )); then
        printf '\nUpdate check: unable to determine %d image(s).\n' "${UPDATE_CHECK_UNDETERMINED}" >&2
        return 1
    fi
    if (( UPDATE_CHECK_AVAILABLE > 0 )); then
        printf '\nUpdate check: %d update(s) available.\n' "${UPDATE_CHECK_AVAILABLE}"
    else
        printf '\nUpdate check: all configured images are up to date.\n'
    fi
}

command_update() {
    local operation_dir
    local update_answer=""

    require_root "update"
    require_operation_lock
    require_appliance
    require_docker
    load_access_state || die "The appliance access state is missing or invalid."
    require_mdns_runtime
    require_https_verification_ready
    compose config --quiet || die "The appliance Compose configuration is invalid."

    [[ -r /dev/tty ]] || die "An interactive terminal is required to confirm an update."
    printf '%s\n\n' 'Make sure you have a current backup.'
    printf '%s\n' 'Kein Backup, keine Gnade.'
    printf '%s\n\n' 'No backup, no mercy.'
    if ! read -r -p 'Continue? [y/N] ' update_answer </dev/tty; then
        die "Unable to read update confirmation."
    fi
    if [[ "${update_answer}" != "y" && "${update_answer}" != "Y" ]]; then
        info "Update cancelled; images and containers were not changed."
        return 0
    fi

    operation_dir=$(create_operation_directory)
    install -m 0600 "${CADDY_ROOT_CA}" "${operation_dir}/root-ca"

    info "Pulling Vaultwarden and Caddy images..."
    if ! compose pull vaultwarden caddy; then
        cleanup_operation_directory "${operation_dir}"
        die "Container image update failed while pulling images."
    fi
    info "Applying image updates..."
    if ! compose up -d vaultwarden caddy || ! verify_appliance; then
        cleanup_operation_directory "${operation_dir}"
        die "Updated appliance container verification failed."
    fi
    if ! verify_root_ca_unchanged "${operation_dir}/root-ca"; then
        cleanup_operation_directory "${operation_dir}"
        die "The Caddy root CA changed unexpectedly."
    fi

    cleanup_operation_directory "${operation_dir}"
    info "Appliance containers updated and verified."
}

command_restart() {
    local operation_dir

    require_root "restart"
    require_operation_lock
    require_appliance
    require_docker
    load_access_state || die "The appliance access state is missing or invalid."
    require_mdns_runtime
    require_https_verification_ready
    compose config --quiet || die "The appliance Compose configuration is invalid."

    operation_dir=$(create_operation_directory)
    install -m 0600 "${CADDY_ROOT_CA}" "${operation_dir}/root-ca"

    info "Recreating Vaultwarden and Caddy containers with persistent data preserved..."
    if ! compose up -d --force-recreate vaultwarden caddy || ! verify_appliance; then
        cleanup_operation_directory "${operation_dir}"
        die "Restarted appliance container verification failed."
    fi
    if ! verify_root_ca_unchanged "${operation_dir}/root-ca"; then
        cleanup_operation_directory "${operation_dir}"
        die "The Caddy root CA changed unexpectedly."
    fi

    cleanup_operation_directory "${operation_dir}"
    info "Appliance containers restarted and verified."
}

validate_caddy_configuration() {
    local command_output=""

    if ! command_output=$(compose run --rm --no-deps --entrypoint caddy \
        caddy fmt --diff /etc/caddy/Caddyfile 2>&1); then
        printf '[FAIL] The generated Caddyfile is not correctly formatted.\n' >&2
        [[ -z "${command_output}" ]] || printf '%s\n' "${command_output}" >&2
        return 1
    fi

    if ! command_output=$(compose run --rm --no-deps --entrypoint caddy \
        caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile 2>&1); then
        printf '[FAIL] Caddy rejected the generated Caddyfile.\n' >&2
        [[ -z "${command_output}" ]] || printf '%s\n' "${command_output}" >&2
        return 1
    fi
}

report_access_change_failure() {
    printf 'The new access configuration was not rolled back.\n' >&2
    printf 'Persistent Vaultwarden and Caddy data were not deleted.\n' >&2
    printf 'Generated Caddyfile: %s\n' "${CADDYFILE}" >&2
    printf 'Access state: %s\n' "${ACCESS_FILE}" >&2
    printf 'Correct the reported problem, then rerun vwctl access.\n' >&2
    docker ps -a --filter name='^/caddy$' >&2 || true
    if docker inspect caddy >/dev/null 2>&1; then
        docker logs --tail 30 caddy >&2 || true
    fi
}

apply_access_change() {
    local new_address=$1
    local caddy_candidate
    local root_hash_before
    local signup_value
    local state_candidate
    local vaultwarden_candidate

    validate_local_hostname "${new_address}" || die "The requested .local hostname is invalid."

    require_mdns_runtime
    require_https_verification_ready
    command_exists sha256sum || die "sha256sum is required to verify Caddy's root CA."
    compose config --quiet || die "The appliance Compose configuration is invalid."
    root_hash_before=$(root_ca_hash) || die "Unable to record Caddy's persistent root CA hash."
    signup_value=$(current_signup_value)
    [[ "${signup_value}" == "true" || "${signup_value}" == "false" ]] ||
        die "Unable to preserve the current signup state."

    caddy_candidate=$(mktemp "${INSTALL_DIR}/.Caddyfile.vwctl.XXXXXXXX") || \
        die "Unable to create a temporary Caddyfile."
    state_candidate=$(mktemp "${INSTALL_DIR}/.caddy-access.vwctl.XXXXXXXX") || {
        rm -f -- "${caddy_candidate}"
        die "Unable to create a temporary access state file."
    }
    vaultwarden_candidate=$(mktemp "${INSTALL_DIR}/.docker-compose.vwctl.XXXXXXXX") || {
        rm -f -- "${caddy_candidate}" "${state_candidate}"
        die "Unable to create a temporary Vaultwarden configuration."
    }

    if ! write_caddyfile_to "${caddy_candidate}" "${new_address}" ||
       ! write_access_state_to "${state_candidate}" "${new_address}" ||
       ! write_vaultwarden_override_to "${vaultwarden_candidate}" "${new_address}" "${signup_value}" ||
       ! compose_with_vaultwarden_candidate "${vaultwarden_candidate}" config --quiet; then
        rm -f -- "${caddy_candidate}" "${state_candidate}" "${vaultwarden_candidate}"
        die "Unable to generate the new access configuration."
    fi

    info "Stopping and removing only the Caddy container..."
    if ! compose rm --stop --force caddy; then
        rm -f -- "${caddy_candidate}" "${state_candidate}" "${vaultwarden_candidate}"
        die "Docker Compose could not stop and remove Caddy."
    fi

    if ! mv -f -- "${caddy_candidate}" "${CADDYFILE}" ||
       ! mv -f -- "${state_candidate}" "${ACCESS_FILE}" ||
       ! mv -f -- "${vaultwarden_candidate}" "${VWCTL_COMPOSE_FILE}"; then
        rm -f -- "${caddy_candidate}" "${state_candidate}" "${vaultwarden_candidate}"
        printf '[FAIL] The new access and Vaultwarden DOMAIN files could not be installed.\n' >&2
        report_access_change_failure
        return 1
    fi

    if ! validate_caddy_configuration; then
        report_access_change_failure
        return 1
    fi

    info "Updating the appliance mDNS advertisement to ${new_address}..."
    if ! configure_mdns_hostname "${new_address}"; then
        printf '[FAIL] The appliance mDNS hostname could not be updated.\n' >&2
        report_access_change_failure
        return 1
    fi

    info "Applying Vaultwarden DOMAIN=https://${new_address}..."
    if ! compose up -d vaultwarden ||
       ! wait_for_container vaultwarden ||
       ! vaultwarden_domain_matches "${new_address}"; then
        printf '[FAIL] Vaultwarden did not start with DOMAIN=https://%s.\n' "${new_address}" >&2
        report_access_change_failure
        return 1
    fi

    info "Creating a clean Caddy container for https://${new_address}..."
    if ! compose up -d --no-deps caddy; then
        printf '[FAIL] Docker Compose could not create Caddy.\n' >&2
        report_access_change_failure
        return 1
    fi

    if ! verify_access_change "${new_address}" "${root_hash_before}"; then
        report_access_change_failure
        return 1
    fi

    ACCESS_ADDRESS=${new_address}
    info "Access configuration changed successfully."
    info "URL: https://${new_address}"
}

confirm_access_change() {
    local address=$1
    local answer=""

    if ! read -r -p "Rebuild Caddy for https://${address}? [y/N] " answer </dev/tty; then
        die "Unable to read confirmation."
    fi
    case "${answer}" in
        y|Y|yes|YES|Yes)
            return 0
            ;;
        *)
            info "Access configuration was not changed."
            return 1
            ;;
    esac
}

access_hostname() {
    local conflict_answer=""
    local hostname=""
    local current_ip
    local default_hostname=${ACCESS_ADDRESS:-${DEFAULT_MDNS_HOSTNAME}}
    local suggestion=""

    require_mdns_runtime
    current_ip=$(detect_ipv4_address) || die "Unable to detect a usable LAN IPv4 address for mDNS verification."
    while true; do
        if ! read -r -p "Local Vaultwarden name [${default_hostname}]: " hostname </dev/tty; then
            die "Unable to read the hostname."
        fi
        hostname=${hostname:-${default_hostname}}
        hostname=${hostname,,}
        if ! validate_local_hostname "${hostname}"; then
            printf 'Invalid local name. Use one DNS label followed by .local, without spaces or underscores.\n' >&2
            continue
        fi
        if [[ "${hostname}" == "${ACCESS_ADDRESS}" ]]; then
            info "The appliance already uses https://${hostname}; no change is needed."
            if ! vaultwarden_domain_matches "${hostname}"; then
                die "The running Vaultwarden DOMAIN is inconsistent. Rerun install.sh to reconcile it."
            fi
            return 0
        fi
        if ! mdns_name_conflicts "${hostname}"; then
            break
        fi

        printf 'The mDNS name %s is already advertised by another LAN device.\n' "${hostname}" >&2
        suggestion=$(next_available_mdns_hostname "${hostname}") || \
            die "Unable to find an available alternative .local name."
        if ! read -r -p "Use available alternative ${suggestion}? [Y/n] " conflict_answer </dev/tty; then
            die "Unable to read the mDNS conflict choice."
        fi
        case "${conflict_answer}" in
            ""|y|Y|yes|YES|Yes) hostname=${suggestion}; break ;;
            *) info "Choose a different .local name." ;;
        esac
    done

    info "mDNS mapping: ${hostname} -> ${current_ip}"
    info "The appliance will not change the system hostname, DNS, router, hosts files, or IP configuration."
    info "New HTTPS URL: https://${hostname}"
    confirm_access_change "${hostname}" || return 0
    apply_access_change "${hostname}"
}

command_access() {
    local requested_mode=${1:-}

    require_root "access${requested_mode:+ ${requested_mode}}"
    require_operation_lock
    require_appliance
    require_docker
    [[ -r /dev/tty ]] || die "An interactive terminal is required for access changes."
    load_access_state || die "The current access state is missing or invalid."

    case "${requested_mode}" in
        ""|hostname) access_hostname ;;
        *) die "Usage: sudo vwctl access [hostname]" ;;
    esac
}

restore_signup_configuration() {
    local backup_dir=$1
    local had_override=$2
    local old_value=$3

    info "Restoring the previous signup configuration..."
    if (( had_override == 1 )); then
        install -m 0644 "${backup_dir}/signup-compose" "${VWCTL_COMPOSE_FILE}"
    else
        rm -f -- "${VWCTL_COMPOSE_FILE}"
    fi

    if compose up -d vaultwarden &&
       wait_for_container vaultwarden &&
       [[ "$(current_signup_value)" == "${old_value}" ]] &&
       vaultwarden_domain_matches "${ACCESS_ADDRESS}"; then
        info "The signup change failed; the previous configuration was restored and verified."
    else
        printf 'CRITICAL: Signup rollback verification failed. Inspect: docker logs vaultwarden\n' >&2
    fi
    return 1
}

change_signup() {
    local new_value=$1
    local backup_dir
    local candidate
    local had_override=0
    local old_value

    load_access_state || die "The appliance access state is missing or invalid."
    old_value=$(current_signup_value)
    [[ "${old_value}" == "true" || "${old_value}" == "false" ]] || \
        die "Unable to determine the current signup state."
    if [[ "${old_value}" == "${new_value}" ]]; then
        info "Signup is already $([[ "${new_value}" == "true" ]] && printf enabled || printf disabled)."
        return 0
    fi

    backup_dir=$(create_operation_directory)
    candidate=$(mktemp "${INSTALL_DIR}/.docker-compose.vwctl.XXXXXXXX") || \
        die "Unable to create a temporary signup configuration."

    if [[ -f "${VWCTL_COMPOSE_FILE}" && ! -L "${VWCTL_COMPOSE_FILE}" ]]; then
        install -m 0600 "${VWCTL_COMPOSE_FILE}" "${backup_dir}/signup-compose"
        had_override=1
    elif [[ -e "${VWCTL_COMPOSE_FILE}" ]]; then
        cleanup_operation_directory "${backup_dir}"
        die "The managed signup Compose path is not a safe regular file."
    fi

    if ! write_vaultwarden_override_to "${candidate}" "${ACCESS_ADDRESS}" "${new_value}" ||
       ! compose_with_vaultwarden_candidate "${candidate}" config --quiet; then
        rm -f -- "${candidate}"
        cleanup_operation_directory "${backup_dir}"
        die "The proposed signup Compose configuration is invalid."
    fi

    mv -f -- "${candidate}" "${VWCTL_COMPOSE_FILE}"
    if ! compose up -d vaultwarden ||
       ! wait_for_container vaultwarden ||
       [[ "$(current_signup_value)" != "${new_value}" ]] ||
       ! vaultwarden_domain_matches "${ACCESS_ADDRESS}"; then
        restore_signup_configuration "${backup_dir}" "${had_override}" "${old_value}" || true
        cleanup_operation_directory "${backup_dir}"
        return 1
    fi

    cleanup_operation_directory "${backup_dir}"
    if [[ "${new_value}" == "true" ]]; then
        info "Signup is enabled."
    else
        info "Signup is disabled."
    fi
}

command_signup() {
    local action=${1:-}
    local state

    case "${action}" in
        status)
            require_appliance
            require_docker
            state=$(current_signup_value)
            case "${state}" in
                true) info "Signup is enabled." ;;
                false) info "Signup is disabled." ;;
                *) die "Unable to determine the signup state." ;;
            esac
            ;;
        on)
            require_root "signup on"
            require_operation_lock
            require_appliance
            require_docker
            change_signup true
            ;;
        off)
            require_root "signup off"
            require_operation_lock
            require_appliance
            require_docker
            change_signup false
            ;;
        *)
            die "Usage: vwctl signup status | sudo vwctl signup on|off"
            ;;
    esac
}

require_storage_discovery() {
    command_exists lsblk || die "lsblk is required for block-device discovery. Rerun the installer."
    command_exists findmnt || die "findmnt is required for system-device protection. Rerun the installer."
}

discover_storage_devices() {
    local candidates=""

    require_storage_discovery
    USB_TOPOLOGY=$(storage_collect_topology) || return 1
    USB_SYSTEM_MOUNTS=$(storage_collect_system_mounts "${USB_TOPOLOGY}") || return 1
    USB_PROTECTED_DISKS=$(storage_protected_disks_from_mounts \
        "${USB_TOPOLOGY}" "${USB_SYSTEM_MOUNTS}") || return 1
    candidates=$(storage_candidate_disks "${USB_TOPOLOGY}" "${USB_PROTECTED_DISKS}") || return 1
    USB_CANDIDATES=()
    if [[ -n "${candidates}" ]]; then
        mapfile -t USB_CANDIDATES <<<"${candidates}"
    fi
}

usb_disk_label() {
    local disk=$1
    local model=""
    local vendor=""

    vendor=$(storage_lsblk_property "${disk}" VENDOR || true)
    model=$(storage_lsblk_property "${disk}" MODEL || true)
    if [[ -n "${vendor}${model}" ]]; then
        storage_sanitize_text "${vendor} ${model}"
    else
        printf '%s\n' "${disk##*/}"
    fi
}

usb_disk_size() {
    local disk=$1
    local bytes

    bytes=$(storage_inventory_node_field "${USB_TOPOLOGY}" "${disk}" size) || return 1
    storage_format_bytes "${bytes}"
}

usb_disk_partitions() {
    local disk=$1
    local node
    local type

    while IFS= read -r node; do
        [[ "${node}" != "${disk}" ]] || continue
        type=$(storage_inventory_node_field "${USB_TOPOLOGY}" "${node}" type) || continue
        [[ "${type}" == "part" ]] && printf '%s\n' "${node}"
    done < <(storage_disk_nodes "${USB_TOPOLOGY}" "${disk}") | storage_join_lines
}

usb_disk_filesystems() {
    storage_disk_property_values "${USB_TOPOLOGY}" "$1" FSTYPE | storage_join_lines
}

usb_disk_mountpoints() {
    storage_disk_property_values "${USB_TOPOLOGY}" "$1" MOUNTPOINTS | storage_join_lines
}

usb_print_system_devices() {
    local disk
    local filesystems
    local label
    local model
    local mountpoints
    local partitions
    local reason
    local removable
    local serial
    local size
    local transport
    local vendor

    printf 'System device%s:\n\n' "$([[ "${USB_PROTECTED_DISKS}" == *$'\n'* ]] && printf s)"
    while IFS='|' read -r disk reason; do
        label=$(usb_disk_label "${disk}" || printf '%s' "${disk##*/}")
        size=$(usb_disk_size "${disk}" || printf unknown)
        vendor=$(storage_lsblk_property "${disk}" VENDOR || true)
        model=$(storage_lsblk_property "${disk}" MODEL || true)
        serial=$(storage_lsblk_property "${disk}" SERIAL || true)
        transport=$(storage_lsblk_property "${disk}" TRAN || true)
        removable=$(storage_lsblk_property "${disk}" RM || true)
        partitions=$(usb_disk_partitions "${disk}" || true)
        filesystems=$(usb_disk_filesystems "${disk}" || true)
        mountpoints=$(usb_disk_mountpoints "${disk}" || true)

        printf '  %s\n' "${label}"
        printf '  Device: %s\n' "${disk}"
        [[ -z "${vendor}" ]] || printf '  Vendor: %s\n' "${vendor}"
        [[ -z "${model}" ]] || printf '  Model: %s\n' "${model}"
        [[ -z "${serial}" ]] || printf '  Serial: %s\n' "${serial}"
        printf '  Size: %s\n' "${size}"
        printf '  Transport: %s\n' "${transport:-unknown}"
        case "${removable}" in
            1) printf '  Removable: yes\n' ;;
            0) printf '  Removable: no\n' ;;
            *) printf '  Removable: unknown\n' ;;
        esac
        printf '  Partitions: %s\n' "${partitions:-none}"
        printf '  Filesystem(s): %s\n' "${filesystems:-none}"
        printf '  Mounted: %s\n' "${mountpoints:-no}"
        printf '  Protected: yes (contains %s)\n\n' "${reason}"
    done <<<"${USB_PROTECTED_DISKS}"
}

usb_print_candidate() {
    local disk=$1
    local number=$2
    local filesystems
    local label
    local model
    local mountpoints
    local partitions
    local removable
    local serial
    local size
    local transport
    local vendor

    label=$(usb_disk_label "${disk}" || printf '%s' "${disk##*/}")
    size=$(usb_disk_size "${disk}" || printf unknown)
    vendor=$(storage_lsblk_property "${disk}" VENDOR || true)
    model=$(storage_lsblk_property "${disk}" MODEL || true)
    serial=$(storage_lsblk_property "${disk}" SERIAL || true)
    transport=$(storage_lsblk_property "${disk}" TRAN || true)
    removable=$(storage_lsblk_property "${disk}" RM || true)
    partitions=$(usb_disk_partitions "${disk}" || true)
    filesystems=$(usb_disk_filesystems "${disk}" || true)
    mountpoints=$(usb_disk_mountpoints "${disk}" || true)

    printf '%d) %s\n' "${number}" "${label}"
    printf '   Device: %s\n' "${disk}"
    [[ -z "${vendor}" ]] || printf '   Vendor: %s\n' "${vendor}"
    [[ -z "${model}" ]] || printf '   Model: %s\n' "${model}"
    [[ -z "${serial}" ]] || printf '   Serial: %s\n' "${serial}"
    printf '   Size: %s\n' "${size}"
    printf '   Transport: %s\n' "${transport:-unknown}"
    case "${removable}" in
        1) printf '   Removable: yes\n' ;;
        0) printf '   Removable: no\n' ;;
        *) printf '   Removable: unknown\n' ;;
    esac
    printf '   Partitions: %s\n' "${partitions:-none}"
    printf '   Filesystem(s): %s\n' "${filesystems:-none}"
    printf '   Mounted: %s\n' "${mountpoints:-no}"
    printf '   Protected: no\n\n'
}

usb_print_candidates() {
    local index

    for index in "${!USB_CANDIDATES[@]}"; do
        usb_print_candidate "${USB_CANDIDATES[${index}]}" "$((index + 1))"
    done
}

usb_print_configured_backup_media() {
    local device
    local label
    local matches
    local mountpoints
    local owner
    local permissions
    local state
    local uuid
    local -a devices=()

    [[ -e "${BACKUP_STATE_FILE}" || -L "${BACKUP_STATE_FILE}" ]] || return 0
    [[ -f "${BACKUP_STATE_FILE}" && ! -L "${BACKUP_STATE_FILE}" ]] || \
        die "The configured backup-media state file is unsafe."
    owner=$(stat -c '%u' "${BACKUP_STATE_FILE}" 2>/dev/null) || \
        die "Unable to verify backup-media state ownership."
    permissions=$(stat -c '%a' "${BACKUP_STATE_FILE}" 2>/dev/null) || \
        die "Unable to verify backup-media state permissions."
    [[ "${owner}" == "0" && "${permissions}" =~ ^[0-7]{3,4}$ ]] || \
        die "The configured backup-media state ownership or permissions are invalid."
    (( (8#${permissions} & 8#022) == 0 )) || \
        die "The configured backup-media state file must not be group- or world-writable."
    state=$(storage_read_backup_state "${BACKUP_STATE_FILE}") || \
        die "The configured backup-media state is invalid."
    uuid=${state%%|*}
    label=${state#*|}
    matches=$(storage_devices_for_uuid "${USB_TOPOLOGY}" "${uuid}") || \
        die "Unable to locate the configured backup filesystem safely."
    [[ -z "${matches}" ]] || mapfile -t devices <<<"${matches}"

    printf 'Configured backup media:\n'
    printf '  Label: %s\n' "${label}"
    printf '  UUID: %s\n' "${uuid}"
    if ((${#devices[@]} == 0)); then
        printf '  Present: no\n'
        printf '  Mounted: no\n\n'
        return 0
    fi
    printf '  Present: yes\n'
    if ((${#devices[@]} > 1)); then
        printf '  Device: ambiguous (%d devices report this UUID)\n' "${#devices[@]}"
        printf '  Mounted: unknown\n\n'
        return 0
    fi
    device=${devices[0]}
    mountpoints=$(storage_lsblk_property "${device}" MOUNTPOINTS || true)
    printf '  Device: %s\n' "${device}"
    if [[ -n "${mountpoints}" ]]; then
        printf '  Mounted: yes (%s)\n\n' "${mountpoints}"
    else
        printf '  Mounted: no\n\n'
    fi
}

command_usb_status() {
    require_appliance
    discover_storage_devices || \
        die "Unable to establish the system block-device topology safely; no backup device can be offered."

    printf 'Backup media\n\n'
    usb_print_configured_backup_media
    usb_print_system_devices
    if ((${#USB_CANDIDATES[@]} == 0)); then
        printf 'No suitable external backup devices detected.\n'
        return 0
    fi
    printf 'Available backup devices:\n\n'
    usb_print_candidates
    printf 'Discovery is read-only. No block device was modified.\n'
}

command_usb_setup() {
    local identity
    local index
    local selected_disk
    local selection=""

    require_root "usb setup"
    require_operation_lock
    require_appliance
    [[ -r /dev/tty ]] || die "An interactive terminal is required for USB device selection."
    discover_storage_devices || \
        die "Unable to establish the system block-device topology safely; no backup device can be offered."

    printf 'Backup media setup — DESTRUCTIVE\n\n'
    usb_print_system_devices
    if ((${#USB_CANDIDATES[@]} == 0)); then
        printf 'No suitable external backup devices detected.\n\n'
        printf 'No changes were made to any device.\n'
        return 0
    fi

    printf 'Available backup devices:\n\n'
    usb_print_candidates
    if ! read -r -p "Select backup device [1-${#USB_CANDIDATES[@]}]: " selection </dev/tty; then
        die "Unable to read the backup-device selection."
    fi
    index=$(storage_selection_index "${selection}" "${#USB_CANDIDATES[@]}") ||
        die "Invalid selection. Enter only one of the displayed device numbers."
    selected_disk=${USB_CANDIDATES[${index}]}

    identity=$(storage_capture_disk_identity "${USB_TOPOLOGY}" "${selected_disk}") || \
        die "Unable to capture a stable identity for the selected physical disk."
    if [[ ! -f "${USB_SETUP_HELPER}" || -L "${USB_SETUP_HELPER}" ]] ||
       ! grep -Fxq '# Vaultwarden Appliance USB setup' "${USB_SETUP_HELPER}"; then
        die "The appliance USB setup helper is missing or unsafe at ${USB_SETUP_HELPER}."
    fi
    bash "${USB_SETUP_HELPER}" "${identity}"
}

command_usb() {
    case "${1:-}" in
        status) command_usb_status ;;
        setup) command_usb_setup ;;
        *) die "Usage: vwctl usb status | sudo vwctl usb setup" ;;
    esac
}

command_cert_export() {
    require_root "cert export"
    require_operation_lock
    require_appliance
    refresh_root_ca_export || die "The public Caddy root CA export failed."

    info "Exported Caddy's public root CA certificate:"
    info "${EXPORTED_ROOT_CA}"
    info "No private CA key was copied."
}

certificate_query() {
    local source_type=$1
    local source=$2
    shift 2

    case "${source_type}" in
        file) openssl x509 -in "${source}" "$@" ;;
        pem) openssl x509 "$@" <<<"${source}" ;;
        *) return 1 ;;
    esac
}

print_certificate_details() {
    local source_type=$1
    local source=$2
    local include_san=$3
    local fingerprint
    local issuer
    local not_after
    local not_before
    local san=""
    local subject

    fingerprint=$(certificate_query "${source_type}" "${source}" -noout -sha256 -fingerprint) || return 1
    subject=$(certificate_query "${source_type}" "${source}" -noout -subject) || return 1
    issuer=$(certificate_query "${source_type}" "${source}" -noout -issuer) || return 1
    not_before=$(certificate_query "${source_type}" "${source}" -noout -startdate) || return 1
    not_after=$(certificate_query "${source_type}" "${source}" -noout -enddate) || return 1

    printf '  SHA-256:   %s\n' "${fingerprint#*=}"
    printf '  Subject:   %s\n' "${subject#subject=}"
    printf '  Issuer:    %s\n' "${issuer#issuer=}"
    printf '  Valid from:  %s\n' "${not_before#notBefore=}"
    printf '  Valid until: %s\n' "${not_after#notAfter=}"

    if [[ "${include_san}" == "yes" ]]; then
        san=$(certificate_query "${source_type}" "${source}" -noout -ext subjectAltName 2>/dev/null |
            awk 'NR > 1 {sub(/^[[:space:]]*/, ""); printf "%s%s", separator, $0; separator=" "}' || true)
        printf '  SAN:       %s\n' "${san:-unavailable}"
    fi
}

command_cert_info() {
    local leaf_certificate

    require_appliance
    command_exists openssl || die "openssl is required for certificate information and was not found."
    command_exists timeout || die "timeout is required for certificate information and was not found."
    load_access_state || die "The appliance access state is missing or invalid."
    [[ -f "${EXPORTED_ROOT_CA}" && ! -L "${EXPORTED_ROOT_CA}" ]] || \
        die "The exported Caddy root CA is missing at ${EXPORTED_ROOT_CA}."

    printf 'Root CA:\n'
    printf '  Path:      %s\n' "${EXPORTED_ROOT_CA}"
    print_certificate_details file "${EXPORTED_ROOT_CA}" no || \
        die "The exported Caddy root CA could not be parsed."

    printf '\nServer certificate:\n'
    printf '  Hostname:  %s\n' "${ACCESS_ADDRESS}"
    leaf_certificate=$(timeout 10 openssl s_client \
        -connect 127.0.0.1:443 \
        -servername "${ACCESS_ADDRESS}" \
        -verify_hostname "${ACCESS_ADDRESS}" \
        -verify_return_error \
        -CAfile "${EXPORTED_ROOT_CA}" </dev/null 2>/dev/null |
        openssl x509 -outform PEM 2>/dev/null) || \
        die "Unable to obtain and validate the live HTTPS server certificate for ${ACCESS_ADDRESS}."
    [[ -n "${leaf_certificate}" ]] || \
        die "The live HTTPS endpoint did not provide a server certificate."
    print_certificate_details pem "${leaf_certificate}" yes || \
        die "The HTTPS server certificate could not be parsed."

    info "No private CA or server key was accessed."
}

main() {
    local command=${1:-help}

    case "${command}" in
        help|--help)
            (( $# <= 1 )) || die "Usage: vwctl help"
            show_help
            ;;
        status)
            (( $# == 1 )) || die "Usage: vwctl status"
            command_status
            ;;
        health)
            (( $# == 1 )) || die "Usage: vwctl health"
            command_health
            ;;
        logs)
            (( $# <= 2 )) || die "Usage: vwctl logs [vaultwarden|caddy]"
            command_logs "${2:-}"
            ;;
        start)
            (( $# == 1 )) || die "Usage: sudo vwctl start"
            command_start
            ;;
        stop)
            (( $# == 1 )) || die "Usage: sudo vwctl stop"
            command_stop
            ;;
        update)
            if (( $# == 1 )); then
                command_update
            elif [[ "${2:-}" == "check" && $# == 2 ]]; then
                command_update_check
            else
                die "Usage: sudo vwctl update | vwctl update check"
            fi
            ;;
        restart)
            (( $# == 1 )) || die "Usage: sudo vwctl restart"
            command_restart
            ;;
        access)
            (( $# <= 2 )) || die "Usage: sudo vwctl access [hostname]"
            command_access "${2:-}"
            ;;
        version)
            (( $# == 1 )) || die "Usage: vwctl version"
            command_version
            ;;
        signup)
            (( $# == 2 )) || die "Usage: vwctl signup status | sudo vwctl signup on|off"
            command_signup "${2}"
            ;;
        cert)
            if [[ "${2:-}" == "export" && $# == 2 ]]; then
                command_cert_export
            elif [[ "${2:-}" == "info" && $# == 2 ]]; then
                command_cert_info
            else
                die "Usage: vwctl cert info | sudo vwctl cert export"
            fi
            ;;
        usb)
            (( $# == 2 )) || die "Usage: vwctl usb status | sudo vwctl usb setup"
            command_usb "${2}"
            ;;
        *)
            die "Unknown command '${command}'. Run 'vwctl help'."
            ;;
    esac
}

main "$@"
