#!/usr/bin/env bash
# Vaultwarden Appliance manual backup

set -o errexit
set -o nounset
set -o pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
readonly SCRIPT_DIR
if [[ -f "${SCRIPT_DIR}/../lib/common.sh" && ! -L "${SCRIPT_DIR}/../lib/common.sh" ]]; then
    LIB_DIR=$(cd -- "${SCRIPT_DIR}/../lib" && pwd -P)
else
    LIB_DIR="/usr/local/lib/vaultwarden-appliance"
fi
readonly LIB_DIR
for library in common network docker storage; do
    library_path="${LIB_DIR}/${library}.sh"
    if [[ ! -f "${library_path}" || -L "${library_path}" ]]; then
        printf 'Error: Required backup library is missing or unsafe: %s\n' \
            "${library_path}" >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    . "${library_path}"
done
unset library library_path

readonly INSTALL_DIR="/opt/vaultwarden"
readonly APPLIANCE_MARKER="${INSTALL_DIR}/.vaultwarden-appliance"
readonly APPLIANCE_VERSION_FILE="${INSTALL_DIR}/.appliance-version"
readonly BACKUP_STATE_FILE="${INSTALL_DIR}/.backup-device"
readonly LOCAL_BACKUP_DIR="${INSTALL_DIR}/backups"
readonly VAULTWARDEN_DATA_DIR="${INSTALL_DIR}/data/vaultwarden"
readonly CADDY_DATA_DIR="${INSTALL_DIR}/data/caddy"
readonly CADDY_ROOT_CA_RELATIVE="data/caddy/pki/authorities/local/root.crt"
readonly CADDY_ROOT_KEY_RELATIVE="data/caddy/pki/authorities/local/root.key"
readonly RUNTIME_DIR="/run/vaultwarden-appliance"
readonly BACKUP_MOUNTPOINT="${RUNTIME_DIR}/backup"
readonly BACKUP_SCHEMA="1"
readonly BACKUP_LABEL="VWBACKUP"
readonly BACKUP_OVERHEAD_BYTES=$((64 * 1024 * 1024))
readonly LOCAL_RETENTION_GENERATIONS=7
readonly USB_RETENTION_GENERATIONS=30
readonly BACKUP_ARCHIVE_PATTERN='^vaultwarden-appliance-[0-9]{8}-[0-9]{6}(-[0-9]{2})?\.tar\.gz$'
readonly BACKUP_TIMER_SERVICE="vaultwarden-appliance-backup.service"
readonly BACKUP_TIMER_UNIT="vaultwarden-appliance-backup.timer"

BACKUP_TOPOLOGY=""
BACKUP_SYSTEM_MOUNTS=""
BACKUP_PROTECTED_DISKS=""
BACKUP_DEVICE=""
BACKUP_DISK=""
BACKUP_UUID=""
BACKUP_ACTIVE_MOUNTPOINT=""
BACKUP_WORK_DIR=""
BACKUP_TEMP_DATABASE=""
BACKUP_MOUNTED_BY_APPLIANCE=0
BACKUP_MOUNTPOINT_CREATED=0
BACKUP_LOCAL_ARCHIVE=""
BACKUP_LOCAL_PARTIAL_ARCHIVE=""
BACKUP_LOCAL_PARTIAL_CHECKSUM=""
BACKUP_USB_PARTIAL_ARCHIVE=""
BACKUP_USB_PARTIAL_CHECKSUM=""

backup_ok() {
    printf '[ OK ] %s\n' "$1"
}

backup_error() {
    printf 'Error: %s\n' "$*" >&2
}

backup_remove_work_directory() {
    local directory=$1
    local runtime_root=$2

    [[ "${runtime_root}" == /* && "${runtime_root}" != "/" &&
       "${directory}" == "${runtime_root}"/backup-work.* &&
       -d "${directory}" && ! -L "${directory}" ]] || return 1
    rm -rf -- "${directory}"
}

backup_cleanup() {
    local original_status=$1
    local final_status=${original_status}

    trap - EXIT INT TERM
    if [[ -n "${BACKUP_ACTIVE_MOUNTPOINT}" ]]; then
        backup_remove_partial_file "${BACKUP_USB_PARTIAL_ARCHIVE}" \
            "${BACKUP_ACTIVE_MOUNTPOINT}/backups" || final_status=1
        backup_remove_partial_file "${BACKUP_USB_PARTIAL_CHECKSUM}" \
            "${BACKUP_ACTIVE_MOUNTPOINT}/backups" || final_status=1
    fi
    if (( BACKUP_MOUNTED_BY_APPLIANCE == 1 )); then
        sync -f "${BACKUP_ACTIVE_MOUNTPOINT}" >/dev/null 2>&1 || true
        if umount -- "${BACKUP_ACTIVE_MOUNTPOINT}"; then
            BACKUP_MOUNTED_BY_APPLIANCE=0
        else
            backup_error "Unable to unmount backup filesystem during cleanup."
            final_status=1
        fi
    fi
    if [[ -n "${BACKUP_TEMP_DATABASE}" &&
          "${BACKUP_TEMP_DATABASE}" == "${VAULTWARDEN_DATA_DIR}"/db_[0-9]*_[0-9]*.sqlite3 &&
          -f "${BACKUP_TEMP_DATABASE}" && ! -L "${BACKUP_TEMP_DATABASE}" ]]; then
        rm -f -- "${BACKUP_TEMP_DATABASE}" || {
            backup_error "Unable to remove the temporary Vaultwarden database snapshot."
            final_status=1
        }
    fi
    if [[ -n "${BACKUP_WORK_DIR}" && -d "${BACKUP_WORK_DIR}" ]]; then
        backup_remove_work_directory "${BACKUP_WORK_DIR}" "${RUNTIME_DIR}" || {
            backup_error "Unable to remove sensitive backup staging data."
            final_status=1
        }
    fi
    backup_remove_partial_file "${BACKUP_LOCAL_PARTIAL_ARCHIVE}" "${LOCAL_BACKUP_DIR}" || final_status=1
    backup_remove_partial_file "${BACKUP_LOCAL_PARTIAL_CHECKSUM}" "${LOCAL_BACKUP_DIR}" || final_status=1
    if (( BACKUP_MOUNTPOINT_CREATED == 1 )) &&
       [[ -d "${BACKUP_MOUNTPOINT}" && ! -L "${BACKUP_MOUNTPOINT}" ]]; then
        rmdir -- "${BACKUP_MOUNTPOINT}" 2>/dev/null || true
    fi
    exit "${final_status}"
}

backup_remove_partial_file() {
    local candidate=$1
    local managed_directory=$2

    [[ -n "${candidate}" ]] || return 0
    [[ "${managed_directory}" == /* && "${managed_directory}" != "/" &&
       "${candidate}" == "${managed_directory}"/.vaultwarden-appliance-*.partial.* ]] || return 1
    if [[ -e "${candidate}" || -L "${candidate}" ]]; then
        [[ -f "${candidate}" && ! -L "${candidate}" ]] || return 1
        rm -f -- "${candidate}"
    fi
}

backup_die() {
    backup_error "$*"
    exit 1
}

backup_require_environment() {
    local command

    (( EUID == 0 )) || backup_die "Backup must run as root through sudo vwctl backup."
    [[ -d "${INSTALL_DIR}" && ! -L "${INSTALL_DIR}" ]] || \
        backup_die "The appliance installation directory is missing or unsafe."
    [[ -f "${APPLIANCE_MARKER}" && ! -L "${APPLIANCE_MARKER}" ]] || \
        backup_die "The appliance marker is missing or unsafe."
    [[ -f "${APPLIANCE_VERSION_FILE}" && ! -L "${APPLIANCE_VERSION_FILE}" ]] || \
        backup_die "The appliance version state is missing or unsafe."
    [[ -d "${VAULTWARDEN_DATA_DIR}" && ! -L "${VAULTWARDEN_DATA_DIR}" ]] || \
        backup_die "Vaultwarden persistent data is missing or unsafe."
    [[ -d "${CADDY_DATA_DIR}" && ! -L "${CADDY_DATA_DIR}" ]] || \
        backup_die "Caddy persistent data is missing or unsafe."
    [[ -f "${CADDY_DATA_DIR}/${CADDY_ROOT_CA_RELATIVE}" &&
       ! -L "${CADDY_DATA_DIR}/${CADDY_ROOT_CA_RELATIVE}" ]] || \
        backup_die "Caddy's persistent internal root CA is missing or unsafe."
    [[ -f "${CADDY_DATA_DIR}/${CADDY_ROOT_KEY_RELATIVE}" &&
       ! -L "${CADDY_DATA_DIR}/${CADDY_ROOT_KEY_RELATIVE}" ]] || \
        backup_die "Caddy's persistent internal CA private key is missing or unsafe."
    for command in docker lsblk findmnt readlink stat mount umount tar gzip \
        sha256sum sync df du find install mktemp date uname awk grep mv rm \
        mkdir rmdir chmod chgrp dirname sort cp; do
        command_exists "${command}" || \
            backup_die "Required backup command '${command}' is unavailable. Rerun the installer."
    done
    docker info >/dev/null 2>&1 || backup_die "The Docker daemon is unavailable."
    container_is_running vaultwarden || backup_die "The Vaultwarden container is not running."
    backup_local_directory_is_safe "${LOCAL_BACKUP_DIR}" || \
        backup_die "The local backup directory is missing or unsafe. Rerun the installer."
}

backup_local_directory_is_safe() {
    local directory=$1
    local owner
    local permissions

    [[ -d "${directory}" && ! -L "${directory}" ]] || return 1
    owner=$(stat -c '%u' "${directory}" 2>/dev/null) || return 1
    permissions=$(stat -c '%a' "${directory}" 2>/dev/null) || return 1
    [[ "${owner}" == "0" && "${permissions}" =~ ^[0-7]{3,4}$ ]] || return 1
    (( (8#${permissions} & 8#002) == 0 ))
}

backup_refresh_storage() {
    BACKUP_TOPOLOGY=$(storage_collect_topology) || return 1
    BACKUP_SYSTEM_MOUNTS=$(storage_collect_system_mounts "${BACKUP_TOPOLOGY}") || return 1
    BACKUP_PROTECTED_DISKS=$(storage_protected_disks_from_mounts \
        "${BACKUP_TOPOLOGY}" "${BACKUP_SYSTEM_MOUNTS}") || return 1
}

backup_read_state_file() {
    local state_file=$1
    local label
    local owner
    local permissions
    local state

    [[ ! -e "${state_file}" && ! -L "${state_file}" ]] && return 2
    [[ -f "${state_file}" && ! -L "${state_file}" ]] || return 1
    owner=$(stat -c '%u' "${state_file}" 2>/dev/null) || return 1
    permissions=$(stat -c '%a' "${state_file}" 2>/dev/null) || return 1
    [[ "${owner}" == "0" && "${permissions}" =~ ^[0-7]{3,4}$ ]] || return 1
    (( (8#${permissions} & 8#022) == 0 )) || return 1
    state=$(storage_read_backup_state "${state_file}") || return 1
    BACKUP_UUID=${state%%|*}
    label=${state#*|}
    [[ "${label}" == "${BACKUP_LABEL}" ]] || return 1
}

backup_read_state() {
    backup_read_state_file "${BACKUP_STATE_FILE}"
}

backup_resolve_media() {
    local lookup
    local result
    local -a fields=()

    backup_refresh_storage || return 1
    if lookup=$(storage_lookup_configured_backup \
        "${BACKUP_TOPOLOGY}" "${BACKUP_PROTECTED_DISKS}" \
        "${BACKUP_UUID}" "${BACKUP_LABEL}"); then
        mapfile -t fields <<<"${lookup}"
    else
        result=$?
        case "${result}" in
            2|3|4|5|6|8|9) return "${result}" ;;
            *) return 1 ;;
        esac
    fi
    ((${#fields[@]} == 2)) || return 1
    BACKUP_DEVICE=${fields[0]}
    BACKUP_DISK=${fields[1]}
}

backup_existing_mountpoint() {
    local device=$1
    local output
    local -a mountpoints=()

    output=$(findmnt --noheadings --raw --output TARGET --source "${device}" 2>/dev/null || true)
    [[ -n "${output}" ]] || return 1
    mapfile -t mountpoints <<<"${output}"
    ((${#mountpoints[@]} == 1)) || return 2
    [[ "${mountpoints[0]}" == /* && "${mountpoints[0]}" != *'\x'* &&
       "${mountpoints[0]}" != *$'\n'* ]] || return 2
    printf '%s\n' "${mountpoints[0]}"
}

backup_prepare_runtime_root() {
    local owner
    local permissions

    if [[ ! -e "${RUNTIME_DIR}" ]]; then
        install -d -m 0700 "${RUNTIME_DIR}" || return 1
    fi
    [[ -d "${RUNTIME_DIR}" && ! -L "${RUNTIME_DIR}" ]] || return 1
    owner=$(stat -c '%u' "${RUNTIME_DIR}") || return 1
    permissions=$(stat -c '%a' "${RUNTIME_DIR}") || return 1
    [[ "${owner}" == "0" && "${permissions}" =~ ^[0-7]{3,4}$ ]] || return 1
    (( (8#${permissions} & 8#022) == 0 )) || return 1
}

backup_prepare_runtime_directory() {
    local permissions

    backup_prepare_runtime_root || return 1

    if [[ ! -e "${BACKUP_MOUNTPOINT}" ]]; then
        mkdir -m 0700 -- "${BACKUP_MOUNTPOINT}" || return 1
        BACKUP_MOUNTPOINT_CREATED=1
    fi
    [[ -d "${BACKUP_MOUNTPOINT}" && ! -L "${BACKUP_MOUNTPOINT}" ]] || return 1
    [[ "$(stat -c '%u' "${BACKUP_MOUNTPOINT}")" == "0" ]] || return 1
    permissions=$(stat -c '%a' "${BACKUP_MOUNTPOINT}") || return 1
    [[ "${permissions}" =~ ^[0-7]{3,4}$ ]] || return 1
    (( (8#${permissions} & 8#022) == 0 )) || return 1
    findmnt --mountpoint "${BACKUP_MOUNTPOINT}" >/dev/null 2>&1 && return 1
    [[ -z "$(find "${BACKUP_MOUNTPOINT}" -mindepth 1 -maxdepth 1 -print -quit)" ]] || return 1
}

backup_verify_mounted_media() {
    local expected_device=$1
    local expected_disk=$2
    local mountpoint=$3
    local lookup
    local mounted_source
    local mounted_uuid

    [[ -d "${mountpoint}" && ! -L "${mountpoint}" ]] || return 1
    mounted_source=$(findmnt --noheadings --raw --output SOURCE \
        --target "${mountpoint}" 2>/dev/null) || return 1
    [[ "${mounted_source}" == "${expected_device}" ]] || return 2
    mounted_uuid=$(storage_lsblk_property "${expected_device}" UUID) || return 1
    [[ "${mounted_uuid}" == "${BACKUP_UUID}" ]] || return 2
    backup_refresh_storage || return 1
    lookup=$(storage_lookup_configured_backup \
        "${BACKUP_TOPOLOGY}" "${BACKUP_PROTECTED_DISKS}" \
        "${BACKUP_UUID}" "${BACKUP_LABEL}") || return 1
    [[ "${lookup}" == "${expected_device}"$'\n'"${expected_disk}" ]]
}

backup_prepare_mount() {
    local mount_status
    local mounted=""

    if mounted=$(backup_existing_mountpoint "${BACKUP_DEVICE}"); then
        BACKUP_ACTIVE_MOUNTPOINT=${mounted}
        BACKUP_MOUNTED_BY_APPLIANCE=0
    else
        mount_status=$?
        (( mount_status == 1 )) || return 2
        backup_prepare_runtime_directory || return 3
        mount --types exfat --options rw,nosuid,nodev,noexec \
            --source "${BACKUP_DEVICE}" --target "${BACKUP_MOUNTPOINT}" || return 4
        BACKUP_ACTIVE_MOUNTPOINT=${BACKUP_MOUNTPOINT}
        BACKUP_MOUNTED_BY_APPLIANCE=1
    fi
    backup_verify_mounted_media \
        "${BACKUP_DEVICE}" "${BACKUP_DISK}" "${BACKUP_ACTIVE_MOUNTPOINT}" || return 5
}

backup_estimated_required_bytes() {
    local source_bytes=$1

    [[ "${source_bytes}" =~ ^[0-9]+$ ]] || return 1
    printf '%d\n' "$((source_bytes + source_bytes / 4 + BACKUP_OVERHEAD_BYTES))"
}

backup_has_sufficient_space() {
    local required=$1
    local available=$2

    [[ "${required}" =~ ^[0-9]+$ && "${available}" =~ ^[0-9]+$ ]] || return 1
    (( available >= required ))
}

backup_source_bytes() {
    local vaultwarden_directory=$1
    local caddy_directory=$2
    local total
    local vaultwarden_bytes
    local caddy_bytes

    vaultwarden_bytes=$(du --summarize --bytes "${vaultwarden_directory}" | awk '{print $1}') || return 1
    caddy_bytes=$(du --summarize --bytes "${caddy_directory}" | awk '{print $1}') || return 1
    [[ "${vaultwarden_bytes}" =~ ^[0-9]+$ && "${caddy_bytes}" =~ ^[0-9]+$ ]] || return 1
    total=$((vaultwarden_bytes + caddy_bytes))
    printf '%d\n' "${total}"
}

backup_available_bytes() {
    local mountpoint=$1
    local available

    available=$(df --block-size=1 --output=avail "${mountpoint}" 2>/dev/null |
        awk 'NR == 2 {print $1}') || return 1
    [[ "${available}" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "${available}"
}

backup_create_work_directory() {
    backup_prepare_runtime_root || return 1
    BACKUP_WORK_DIR=$(mktemp -d "${RUNTIME_DIR}/backup-work.XXXXXXXX") || return 1
    [[ "${BACKUP_WORK_DIR}" == "${RUNTIME_DIR}"/backup-work.* &&
       -d "${BACKUP_WORK_DIR}" && ! -L "${BACKUP_WORK_DIR}" ]] || return 1
    chmod 0700 "${BACKUP_WORK_DIR}" || return 1
    install -d -m 0700 \
        "${BACKUP_WORK_DIR}/vaultwarden-appliance-backup/vaultwarden" \
        "${BACKUP_WORK_DIR}/vaultwarden-appliance-backup/appliance"
}

backup_copy_appliance_configuration() {
    local appliance_directory=$1
    local destination=$2
    local source
    local -a files=(
        .vaultwarden-appliance
        .appliance-version
        .backup-device
        docker-compose.yml
        docker-compose.override.yml
        docker-compose.vwctl.yml
        Caddyfile
    )

    for source in "${files[@]}"; do
        [[ -e "${appliance_directory}/${source}" || -L "${appliance_directory}/${source}" ]] || continue
        [[ -f "${appliance_directory}/${source}" && ! -L "${appliance_directory}/${source}" ]] || return 1
        install -m 0600 -- "${appliance_directory}/${source}" "${destination}/${source}" || return 1
    done
    [[ -f "${destination}/.appliance-version" &&
       -f "${destination}/docker-compose.yml" &&
       -f "${destination}/docker-compose.override.yml" ]]
}

backup_manifest_value() {
    local value

    value=$(storage_sanitize_text "$1") || return 1
    [[ -n "${value}" && "${value}" == "$1" &&
       "${value}" != *$'\n'* && "${value}" != *$'\r'* ]] || return 1
    printf '%s\n' "${value}"
}

backup_write_manifest() {
    local destination=$1
    local appliance_version=$2
    local created_at=$3
    local signup_allowed=$4
    local vaultwarden_image=$5
    local vaultwarden_version=$6
    local caddy_image=$7
    local caddy_version=$8
    local architecture=$9
    local value

    for value in "${appliance_version}" "${created_at}" \
        "${signup_allowed}" "${vaultwarden_image}" "${vaultwarden_version}" \
        "${caddy_image}" "${caddy_version}" "${architecture}"; do
        backup_manifest_value "${value}" >/dev/null || return 1
    done
    printf '%s\n' \
        "backup_schema=${BACKUP_SCHEMA}" \
        "appliance_version=${appliance_version}" \
        "created_at_utc=${created_at}" \
        "signup_allowed=${signup_allowed}" \
        "vaultwarden_image=${vaultwarden_image}" \
        "vaultwarden_version=${vaultwarden_version}" \
        "caddy_image=${caddy_image}" \
        "caddy_version=${caddy_version}" \
        "source_architecture=${architecture}" \
        'caddy_ca_included=yes' \
        'top_level_contents=manifest,vaultwarden,caddy,appliance' > "${destination}" || return 1
    chmod 0600 "${destination}"
}

backup_builtin_database_snapshots() {
    local data_directory=$1
    local candidate
    local name

    for candidate in "${data_directory}"/db_*.sqlite3; do
        [[ -e "${candidate}" || -L "${candidate}" ]] || continue
        name=${candidate##*/}
        [[ "${name}" =~ ^db_[0-9]{8}_[0-9]{6}\.sqlite3$ ]] || continue
        printf '%s\n' "${candidate}"
    done
}

backup_create_database_snapshot() {
    local data_directory=$1
    local destination=$2
    local candidate
    local command_status=0
    local output
    local -a new_snapshots=()
    local -A before=()

    while IFS= read -r candidate; do
        before["${candidate}"]=1
    done < <(backup_builtin_database_snapshots "${data_directory}")

    output=$(docker exec vaultwarden /vaultwarden backup 2>&1) || command_status=$?
    while IFS= read -r candidate; do
        [[ -z "${before[${candidate}]:-}" ]] || continue
        new_snapshots+=("${candidate}")
    done < <(backup_builtin_database_snapshots "${data_directory}")
    if (( command_status != 0 )); then
        if ((${#new_snapshots[@]} == 1)); then
            candidate=${new_snapshots[0]}
            [[ ! -L "${candidate}" ]] && BACKUP_TEMP_DATABASE=${candidate}
        fi
        [[ -z "${output}" ]] || printf '%s\n' "${output}" >&2
        return 1
    fi
    ((${#new_snapshots[@]} == 1)) || return 1
    candidate=${new_snapshots[0]}
    BACKUP_TEMP_DATABASE=${candidate}
    [[ -f "${candidate}" && ! -L "${candidate}" && -s "${candidate}" ]] || return 1
    mv -- "${candidate}" "${destination}" || return 1
    BACKUP_TEMP_DATABASE=""
    [[ -f "${destination}" && ! -L "${destination}" && -s "${destination}" ]]
}

backup_sources_are_safe() {
    local vaultwarden_directory=$1
    local caddy_directory=$2
    local unexpected

    [[ -d "${vaultwarden_directory}" && ! -L "${vaultwarden_directory}" &&
       -d "${caddy_directory}" && ! -L "${caddy_directory}" ]] || return 1
    unexpected=$(find "${vaultwarden_directory}" "${caddy_directory}" \
        \( ! -type f ! -type d \) -print -quit) || return 1
    [[ -z "${unexpected}" ]]
}

backup_create_archive() {
    local work_directory=$1
    local archive=$2
    local data_directory=$3

    backup_sources_are_safe "${data_directory}/vaultwarden" "${data_directory}/caddy" || return 1
    tar --create --gzip --file "${archive}" \
        --anchored \
        --exclude='vaultwarden/db.sqlite3' \
        --exclude='vaultwarden/db.sqlite3-wal' \
        --exclude='vaultwarden/db.sqlite3-shm' \
        --exclude='vaultwarden/db_*.sqlite3' \
        --exclude='vaultwarden/tmp' \
        --exclude='vaultwarden/tmp/*' \
        --transform='s,^vaultwarden$,vaultwarden-appliance-backup/vaultwarden/data,' \
        --transform='s,^vaultwarden/,vaultwarden-appliance-backup/vaultwarden/data/,' \
        --transform='s,^caddy$,vaultwarden-appliance-backup/caddy,' \
        --transform='s,^caddy/,vaultwarden-appliance-backup/caddy/,' \
        --directory "${work_directory}" vaultwarden-appliance-backup \
        --directory "${data_directory}" vaultwarden caddy
}

backup_verify_archive() {
    local archive=$1
    local listing=$2

    [[ -f "${archive}" && ! -L "${archive}" && -s "${archive}" ]] || return 1
    tar --list --gzip --file "${archive}" > "${listing}" || return 1
    [[ -s "${listing}" ]] || return 1
    awk '
        /^\// {bad=1}
        /(^|\/)\.\.($|\/)/ {bad=1}
        END {exit bad}
    ' "${listing}" || return 1
    grep -Fxq 'vaultwarden-appliance-backup/manifest' "${listing}" || return 2
    grep -Fxq 'vaultwarden-appliance-backup/vaultwarden/db.sqlite3' "${listing}" || return 3
    grep -Eq '^vaultwarden-appliance-backup/vaultwarden/data/?$' "${listing}" || return 4
    grep -Eq '^vaultwarden-appliance-backup/caddy/?$' "${listing}" || return 5
    grep -Fxq \
        "vaultwarden-appliance-backup/caddy/${CADDY_ROOT_CA_RELATIVE}" \
        "${listing}" || return 5
    grep -Fxq \
        "vaultwarden-appliance-backup/caddy/${CADDY_ROOT_KEY_RELATIVE}" \
        "${listing}" || return 5
}

backup_choose_archive_path() {
    local backup_directory=$1
    local timestamp=$2
    local archive
    local suffix
    local index

    [[ "${timestamp}" =~ ^[0-9]{8}-[0-9]{6}$ ]] || return 1
    for ((index = 0; index <= 99; index++)); do
        if (( index == 0 )); then
            suffix=""
        else
            printf -v suffix -- '-%02d' "${index}"
        fi
        archive="${backup_directory}/vaultwarden-appliance-${timestamp}${suffix}.tar.gz"
        if [[ ! -e "${archive}" && ! -L "${archive}" &&
              ! -e "${archive}.sha256" && ! -L "${archive}.sha256" ]]; then
            printf '%s\n' "${archive}"
            return 0
        fi
    done
    return 1
}

backup_write_checksum() {
    local archive=$1
    local checksum="${archive}.sha256"
    local directory
    local filename
    local hash
    local temporary

    directory=$(dirname -- "${archive}") || return 1
    filename=${archive##*/}
    temporary=$(mktemp "${directory}/.${filename}.sha256.partial.XXXXXXXX") || return 1
    if ! (cd -- "${directory}" && sha256sum -- "${filename}") > "${temporary}"; then
        return 2
    fi
    if ! (cd -- "${directory}" && sha256sum --check --strict "${temporary##*/}") >/dev/null; then
        return 3
    fi
    hash=$(awk 'NR == 1 {print $1}' "${temporary}") || return 1
    [[ "${hash}" =~ ^[0-9a-f]{64}$ ]] || return 1
    mv -n -- "${temporary}" "${checksum}" || return 1
    [[ ! -e "${temporary}" && -f "${checksum}" && ! -L "${checksum}" ]] || return 1
    printf '%s\n' "${hash}"
}

backup_archive_name_is_managed() {
    [[ "$1" =~ ${BACKUP_ARCHIVE_PATTERN} ]]
}

backup_verify_generation() {
    local archive=$1
    local checksum="${archive}.sha256"
    local directory
    local filename
    local listing

    [[ -f "${archive}" && ! -L "${archive}" &&
       -f "${checksum}" && ! -L "${checksum}" ]] || return 1
    filename=${archive##*/}
    backup_archive_name_is_managed "${filename}" || return 1
    directory=${archive%/*}
    [[ "${directory}" != "${archive}" && -d "${directory}" && ! -L "${directory}" ]] || return 1
    awk -v filename="${filename}" '
        NR == 1 && length($1) == 64 && $1 ~ /^[0-9a-f]+$/ &&
            ($2 == filename || $2 == "*" filename) {valid=1}
        NR > 1 {valid=0}
        END {exit !valid}
    ' "${checksum}" || return 1
    (cd -- "${directory}" && sha256sum --check --strict "${checksum##*/}") >/dev/null || return 1
    listing=$(mktemp "${TMPDIR:-/tmp}/vaultwarden-backup-list.XXXXXXXX") || return 1
    if backup_verify_archive "${archive}" "${listing}"; then
        rm -f -- "${listing}" || return 1
        return 0
    fi
    rm -f -- "${listing}" || true
    return 1
}

backup_list_valid_generations() {
    local directory=$1
    local output=$2
    local archive
    local candidate
    local name

    [[ -d "${directory}" && ! -L "${directory}" ]] || return 1
    : > "${output}" || return 1
    for candidate in "${directory}"/*; do
        [[ -e "${candidate}" || -L "${candidate}" ]] || continue
        name=${candidate##*/}
        if backup_archive_name_is_managed "${name}" || {
            [[ "${name}" == *.sha256 ]] && backup_archive_name_is_managed "${name%.sha256}"
        }; then
            [[ -f "${candidate}" && ! -L "${candidate}" ]] || return 2
        fi
    done
    for archive in "${directory}"/vaultwarden-appliance-*.tar.gz; do
        [[ -e "${archive}" || -L "${archive}" ]] || continue
        name=${archive##*/}
        backup_archive_name_is_managed "${name}" || continue
        if backup_verify_generation "${archive}"; then
            printf '%s\n' "${archive}" >> "${output}" || return 1
        fi
    done
    sort -o "${output}" "${output}"
}

backup_apply_retention() {
    local directory=$1
    local limit=$2
    local protected_archive=$3
    local temporary_root=$4
    local archive
    local checksum
    local delete_count
    local index
    local list
    local name
    local -a generations=()

    [[ "${limit}" =~ ^[1-9][0-9]*$ && -d "${temporary_root}" && ! -L "${temporary_root}" ]] || return 1
    list=$(mktemp "${temporary_root}/retention.XXXXXXXX") || return 1
    if ! backup_list_valid_generations "${directory}" "${list}"; then
        rm -f -- "${list}" || true
        return 1
    fi
    mapfile -t generations < "${list}"
    rm -f -- "${list}" || return 1
    ((${#generations[@]} > limit)) || return 0
    delete_count=$((${#generations[@]} - limit))
    for ((index = 0; index < delete_count; index++)); do
        archive=${generations[${index}]}
        checksum="${archive}.sha256"
        name=${archive##*/}
        [[ "${archive}" == "${directory}/${name}" && "${archive}" != "${protected_archive}" ]] || return 1
        backup_archive_name_is_managed "${name}" || return 1
        backup_verify_generation "${archive}" || return 1
        [[ -f "${checksum}" && ! -L "${checksum}" ]] || return 1
    done
    for ((index = 0; index < delete_count; index++)); do
        archive=${generations[${index}]}
        checksum="${archive}.sha256"
        name=${archive##*/}
        [[ "${archive}" == "${directory}/${name}" && "${archive}" != "${protected_archive}" ]] || return 1
        backup_archive_name_is_managed "${name}" || return 1
        [[ -f "${archive}" && ! -L "${archive}" &&
           -f "${checksum}" && ! -L "${checksum}" ]] || return 1
        rm -f -- "${archive}" "${checksum}" || return 1
    done
}

backup_install_local_generation() {
    local source_archive=$1
    local destination_archive=$2
    local destination_checksum="${destination_archive}.sha256"
    local filename=${destination_archive##*/}

    [[ -f "${source_archive}" && ! -L "${source_archive}" &&
       -f "${source_archive}.sha256" && ! -L "${source_archive}.sha256" ]] || return 1
    backup_archive_name_is_managed "${filename}" || return 1
    [[ "${destination_archive}" == "${LOCAL_BACKUP_DIR}/${filename}" ]] || return 1
    BACKUP_LOCAL_PARTIAL_ARCHIVE=$(mktemp \
        "${LOCAL_BACKUP_DIR}/.${filename}.partial.XXXXXXXX") || return 1
    BACKUP_LOCAL_PARTIAL_CHECKSUM=$(mktemp \
        "${LOCAL_BACKUP_DIR}/.${filename}.sha256.partial.XXXXXXXX") || return 1
    install -o root -g docker -m 0640 -- "${source_archive}" \
        "${BACKUP_LOCAL_PARTIAL_ARCHIVE}" || return 1
    install -o root -g docker -m 0640 -- "${source_archive}.sha256" \
        "${BACKUP_LOCAL_PARTIAL_CHECKSUM}" || return 1
    sync -f "${BACKUP_LOCAL_PARTIAL_ARCHIVE}" || return 1
    sync -f "${BACKUP_LOCAL_PARTIAL_CHECKSUM}" || return 1
    mv -n -- "${BACKUP_LOCAL_PARTIAL_ARCHIVE}" "${destination_archive}" || return 1
    [[ ! -e "${BACKUP_LOCAL_PARTIAL_ARCHIVE}" && -f "${destination_archive}" ]] || return 1
    BACKUP_LOCAL_PARTIAL_ARCHIVE=""
    mv -n -- "${BACKUP_LOCAL_PARTIAL_CHECKSUM}" "${destination_checksum}" || return 1
    [[ ! -e "${BACKUP_LOCAL_PARTIAL_CHECKSUM}" && -f "${destination_checksum}" ]] || return 1
    BACKUP_LOCAL_PARTIAL_CHECKSUM=""
    sync -f "${LOCAL_BACKUP_DIR}" || return 1
    backup_verify_generation "${destination_archive}"
}

backup_prepare_usb_directory() {
    local directory=$1

    if [[ ! -e "${directory}" && ! -L "${directory}" ]]; then
        mkdir -m 0700 -- "${directory}" || return 1
    fi
    [[ -d "${directory}" && ! -L "${directory}" ]]
}

backup_copy_generation_to_usb() {
    local local_archive=$1
    local usb_directory=$2
    local archive_size
    local available_bytes
    local expected_hash
    local filename=${local_archive##*/}
    local required_bytes
    local usb_archive="${usb_directory}/${filename}"
    local usb_checksum="${usb_archive}.sha256"

    backup_verify_generation "${local_archive}" || return 1
    backup_prepare_usb_directory "${usb_directory}" || return 2
    if [[ -e "${usb_archive}" || -L "${usb_archive}" ||
          -e "${usb_checksum}" || -L "${usb_checksum}" ]]; then
        if backup_verify_generation "${usb_archive}" &&
           [[ "$(awk 'NR == 1 {print $1}' "${local_archive}.sha256")" == \
              "$(awk 'NR == 1 {print $1}' "${usb_checksum}")" ]]; then
            return 0
        fi
        return 3
    fi
    archive_size=$(stat -c '%s' "${local_archive}") || return 1
    required_bytes=$((archive_size + BACKUP_OVERHEAD_BYTES))
    available_bytes=$(backup_available_bytes "${BACKUP_ACTIVE_MOUNTPOINT}") || return 1
    backup_has_sufficient_space "${required_bytes}" "${available_bytes}" || return 4
    BACKUP_USB_PARTIAL_ARCHIVE=$(mktemp \
        "${usb_directory}/.${filename}.partial.XXXXXXXX") || return 1
    BACKUP_USB_PARTIAL_CHECKSUM=$(mktemp \
        "${usb_directory}/.${filename}.sha256.partial.XXXXXXXX") || return 1
    cp -- "${local_archive}" "${BACKUP_USB_PARTIAL_ARCHIVE}" || return 1
    cp -- "${local_archive}.sha256" "${BACKUP_USB_PARTIAL_CHECKSUM}" || return 1
    sync -f "${BACKUP_USB_PARTIAL_ARCHIVE}" || return 1
    sync -f "${BACKUP_USB_PARTIAL_CHECKSUM}" || return 1
    expected_hash=$(awk 'NR == 1 {print $1}' "${local_archive}.sha256") || return 1
    [[ "${expected_hash}" =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ "$(sha256sum -- "${BACKUP_USB_PARTIAL_ARCHIVE}" | awk 'NR == 1 {print $1}')" == \
       "${expected_hash}" ]] || return 5
    backup_verify_archive "${BACKUP_USB_PARTIAL_ARCHIVE}" \
        "${BACKUP_WORK_DIR}/usb-archive.list" || return 6
    mv -n -- "${BACKUP_USB_PARTIAL_ARCHIVE}" "${usb_archive}" || return 1
    [[ ! -e "${BACKUP_USB_PARTIAL_ARCHIVE}" && -f "${usb_archive}" ]] || return 1
    BACKUP_USB_PARTIAL_ARCHIVE=""
    mv -n -- "${BACKUP_USB_PARTIAL_CHECKSUM}" "${usb_checksum}" || return 1
    [[ ! -e "${BACKUP_USB_PARTIAL_CHECKSUM}" && -f "${usb_checksum}" ]] || return 1
    BACKUP_USB_PARTIAL_CHECKSUM=""
    sync -f "${usb_directory}" || return 1
    backup_verify_generation "${usb_archive}"
}

backup_clear_usb_partials() {
    backup_remove_partial_file "${BACKUP_USB_PARTIAL_ARCHIVE}" \
        "${BACKUP_ACTIVE_MOUNTPOINT}/backups" || return 1
    BACKUP_USB_PARTIAL_ARCHIVE=""
    backup_remove_partial_file "${BACKUP_USB_PARTIAL_CHECKSUM}" \
        "${BACKUP_ACTIVE_MOUNTPOINT}/backups" || return 1
    BACKUP_USB_PARTIAL_CHECKSUM=""
}

backup_media_lookup_error() {
    case "$1" in
        2) printf 'configured medium is not connected' ;;
        3) printf 'multiple filesystems report the configured UUID' ;;
        4) printf 'configured filesystem is not exFAT' ;;
        5) printf 'configured filesystem is not labeled %s' "${BACKUP_LABEL}" ;;
        6) printf 'configured filesystem changed during validation' ;;
        8) printf 'configured filesystem is backed by a protected system disk' ;;
        9) printf 'configured filesystem is backed by a virtual device' ;;
        *) printf 'configured filesystem failed safety validation' ;;
    esac
}

backup_finish_mount() {
    sync -f "${BACKUP_ACTIVE_MOUNTPOINT}" || return 1
    sync || return 1
    if (( BACKUP_MOUNTED_BY_APPLIANCE == 1 )); then
        umount -- "${BACKUP_ACTIVE_MOUNTPOINT}" || return 1
        BACKUP_MOUNTED_BY_APPLIANCE=0
        backup_ok "Backup media unmounted"
    else
        backup_ok "Pre-existing backup-media mount preserved"
    fi
}

backup_create_local_generation() {
    local appliance_version
    local caddy_image
    local caddy_version
    local created_at
    local destination_archive
    local signup_allowed
    local staged_archive
    local timestamp
    local vaultwarden_image
    local vaultwarden_version
    local -a version_lines=()

    backup_create_work_directory || backup_die "Unable to create secure runtime staging."
    backup_copy_appliance_configuration "${INSTALL_DIR}" \
        "${BACKUP_WORK_DIR}/vaultwarden-appliance-backup/appliance" || \
        backup_die "Unable to stage appliance configuration."
    mapfile -t version_lines < "${APPLIANCE_VERSION_FILE}"
    ((${#version_lines[@]} == 1)) || backup_die "The appliance version state is invalid."
    appliance_version=${version_lines[0]}
    signup_allowed=$(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' vaultwarden |
        awk -F= '$1 == "SIGNUPS_ALLOWED" {print tolower(substr($0, index($0, "=") + 1)); exit}') || true
    [[ "${signup_allowed}" == "true" || "${signup_allowed}" == "false" ]] || signup_allowed=unknown
    vaultwarden_image=$(docker inspect --format '{{.Config.Image}}' vaultwarden 2>/dev/null || printf unknown)
    caddy_image=$(docker inspect --format '{{.Config.Image}}' caddy 2>/dev/null || printf unknown)
    vaultwarden_version=$(docker exec vaultwarden /vaultwarden --version 2>/dev/null |
        awk 'NF {print; exit}' || true)
    caddy_version=$(docker exec caddy caddy version 2>/dev/null |
        awk 'NF {print; exit}' || true)
    [[ -n "${vaultwarden_version}" ]] || vaultwarden_version=${vaultwarden_image}
    [[ -n "${caddy_version}" ]] || caddy_version=${caddy_image}
    created_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    backup_write_manifest \
        "${BACKUP_WORK_DIR}/vaultwarden-appliance-backup/manifest" \
        "${appliance_version}" "${created_at}" "${signup_allowed}" \
        "${vaultwarden_image}" "${vaultwarden_version}" \
        "${caddy_image}" "${caddy_version}" "$(uname -m)" || \
        backup_die "Unable to create backup manifest."
    backup_create_database_snapshot "${VAULTWARDEN_DATA_DIR}" \
        "${BACKUP_WORK_DIR}/vaultwarden-appliance-backup/vaultwarden/db.sqlite3" || \
        backup_die "Vaultwarden database backup failed."
    backup_ok "Vaultwarden database snapshot created"

    timestamp=$(date -u '+%Y%m%d-%H%M%S')
    destination_archive=$(backup_choose_archive_path "${LOCAL_BACKUP_DIR}" "${timestamp}") || \
        backup_die "Unable to choose a collision-free local backup filename."
    staged_archive="${BACKUP_WORK_DIR}/${destination_archive##*/}"
    backup_create_archive "${BACKUP_WORK_DIR}" "${staged_archive}" "${INSTALL_DIR}/data" || \
        backup_die "Unable to create the local backup archive."
    backup_verify_archive "${staged_archive}" "${BACKUP_WORK_DIR}/archive.list" || \
        backup_die "Local archive integrity verification failed."
    backup_write_checksum "${staged_archive}" >/dev/null || \
        backup_die "Unable to create and verify the local backup checksum."
    backup_verify_generation "${staged_archive}" || \
        backup_die "The staged local backup generation failed final verification."
    backup_install_local_generation "${staged_archive}" "${destination_archive}" || \
        backup_die "Unable to atomically install the verified local backup generation."
    BACKUP_LOCAL_ARCHIVE=${destination_archive}
}

backup_replicate_usb() {
    local local_archive=$1
    local mount_status
    local read_status
    local resolve_status
    local usb_directory
    local copy_status

    if backup_read_state; then
        :
    else
        read_status=$?
        if (( read_status == 2 )); then
            printf '[INFO] USB replication skipped: no backup medium is configured.\n'
            return 0
        fi
        backup_error "USB replication failed: configured backup-media state is unsafe or invalid."
        return 1
    fi
    if backup_resolve_media; then
        :
    else
        resolve_status=$?
        if (( resolve_status == 2 )); then
            printf '[INFO] USB replication skipped: configured medium %s is not connected.\n' \
                "${BACKUP_UUID}"
            return 0
        fi
        backup_error "USB replication failed: $(backup_media_lookup_error "${resolve_status}")."
        return 1
    fi
    backup_ok "Backup media: ${BACKUP_LABEL} (${BACKUP_UUID})"
    if backup_prepare_mount; then
        :
    else
        mount_status=$?
        backup_error "USB replication failed: unable to establish a unique safe writable mount (code ${mount_status})."
        return 1
    fi
    usb_directory="${BACKUP_ACTIVE_MOUNTPOINT}/backups"
    if backup_copy_generation_to_usb "${local_archive}" "${usb_directory}"; then
        backup_ok "Verified local generation replicated to USB"
    else
        copy_status=$?
        case "${copy_status}" in
            2) backup_error "USB replication failed: the managed USB backup directory is unsafe." ;;
            3) backup_error "USB replication failed: the destination filename already contains a different or invalid generation." ;;
            4) backup_error "USB replication failed: insufficient free space; existing backups were not deleted." ;;
            5) backup_error "USB replication failed: copied archive checksum does not match." ;;
            6) backup_error "USB replication failed: copied archive is unreadable or incomplete." ;;
            *) backup_error "USB replication failed while copying the verified local generation." ;;
        esac
        backup_clear_usb_partials || backup_error "Unable to remove incomplete USB temporary files safely."
        backup_finish_mount || backup_error "Unable to unmount backup filesystem after replication failure."
        return 1
    fi
    if ! backup_apply_retention "${usb_directory}" "${USB_RETENTION_GENERATIONS}" \
        "${usb_directory}/${local_archive##*/}" "${BACKUP_WORK_DIR}"; then
        backup_error "USB retention failed closed; the new USB copy and all extra generations were preserved."
        backup_finish_mount || backup_error "Unable to unmount backup filesystem after retention failure."
        return 1
    fi
    backup_ok "USB retention kept the newest ${USB_RETENTION_GENERATIONS} valid generations"
    backup_finish_mount || {
        backup_error "USB copy succeeded, but the appliance could not unmount its temporary mount."
        return 1
    }
}

backup_format_generation_time() {
    local name=${1##*/}

    backup_archive_name_is_managed "${name}" || return 1
    printf '%s-%s-%s %s:%s:%s UTC\n' \
        "${name:22:4}" "${name:26:2}" "${name:28:2}" \
        "${name:31:2}" "${name:33:2}" "${name:35:2}"
}

backup_status_directory() {
    local directory=$1
    local missing_is_empty=${2:-no}
    local list
    local latest
    local -a generations=()

    printf '  Directory:       %s\n' "${directory}"
    if [[ ! -e "${directory}" && ! -L "${directory}" && "${missing_is_empty}" == yes ]]; then
        printf '  Generations:     0\n'
        printf '  Latest:          none\n'
        printf '  Latest file:     none\n'
        printf '  Latest valid:    n/a\n'
        return 0
    fi
    if [[ ! -d "${directory}" || -L "${directory}" || ! -r "${directory}" ]]; then
        printf '  Generations:     unavailable\n'
        printf '  Latest:          unavailable\n'
        printf '  Latest valid:    unavailable\n'
        return 1
    fi
    list=$(mktemp "${TMPDIR:-/tmp}/vaultwarden-backup-status.XXXXXXXX") || return 1
    if ! backup_list_valid_generations "${directory}" "${list}"; then
        rm -f -- "${list}" || true
        printf '  Generations:     unsafe or ambiguous\n'
        printf '  Latest:          unavailable\n'
        printf '  Latest valid:    no\n'
        return 1
    fi
    mapfile -t generations < "${list}"
    rm -f -- "${list}" || return 1
    printf '  Generations:     %d\n' "${#generations[@]}"
    if ((${#generations[@]} == 0)); then
        printf '  Latest:          none\n'
        printf '  Latest file:     none\n'
        printf '  Latest valid:    n/a\n'
        return 0
    fi
    latest=${generations[-1]}
    printf '  Latest:          %s\n' "$(backup_format_generation_time "${latest}")"
    printf '  Latest file:     %s\n' "${latest##*/}"
    printf '  Latest valid:    yes\n'
}

backup_status_usb() {
    local mountpoint
    local mount_status
    local read_status
    local resolve_status

    printf 'USB backup media:\n'
    if backup_read_state; then
        printf '  Configured:      yes\n'
        printf '  Label:           %s\n' "${BACKUP_LABEL}"
        printf '  UUID:            %s\n' "${BACKUP_UUID}"
    else
        read_status=$?
        if (( read_status == 2 )); then
            printf '  Configured:      no\n'
            printf '  Present:         n/a\n'
            return 0
        fi
        printf '  Configured:      unsafe or invalid\n'
        printf '  Present:         unavailable\n'
        return 1
    fi
    if backup_resolve_media; then
        printf '  Present:         yes\n'
    else
        resolve_status=$?
        if (( resolve_status == 2 )); then
            printf '  Present:         no\n'
            printf '  Generations:     unavailable (not mounted)\n'
            return 0
        fi
        printf '  Present:         unsafe (%s)\n' "$(backup_media_lookup_error "${resolve_status}")"
        return 1
    fi
    if mountpoint=$(backup_existing_mountpoint "${BACKUP_DEVICE}"); then
        if backup_verify_mounted_media "${BACKUP_DEVICE}" "${BACKUP_DISK}" "${mountpoint}"; then
            backup_status_directory "${mountpoint}/backups" yes
        else
            printf '  Generations:     unavailable (mounted media failed safety validation)\n'
            return 1
        fi
    else
        mount_status=$?
        if (( mount_status == 2 )); then
            printf '  Generations:     unavailable (multiple or unsafe mountpoints)\n'
            return 1
        fi
        printf '  Generations:     unavailable (safe status does not mount media)\n'
    fi
}

backup_status_timer() {
    local enabled=unavailable
    local last_result=unavailable
    local last_run=unavailable
    local next_run=unavailable

    if command_exists systemctl; then
        if systemctl is-enabled "${BACKUP_TIMER_UNIT}" >/dev/null 2>&1; then
            enabled=enabled
        else
            enabled=disabled
        fi
        last_run=$(systemctl show "${BACKUP_TIMER_SERVICE}" \
            --property=ExecMainStartTimestamp --value 2>/dev/null || true)
        last_result=$(systemctl show "${BACKUP_TIMER_SERVICE}" \
            --property=Result --value 2>/dev/null || true)
        next_run=$(systemctl show "${BACKUP_TIMER_UNIT}" \
            --property=NextElapseUSecRealtime --value 2>/dev/null || true)
    fi
    printf 'Automatic backup:\n'
    printf '  Timer:           %s\n' "${enabled:-unavailable}"
    printf '  Schedule:        daily at 02:30 local time\n'
    printf '  Last run:        %s\n' "${last_run:-never}"
    printf '  Last result:     %s\n' "${last_result:-not run}"
    printf '  Next run:        %s\n' "${next_run:-unavailable}"
}

backup_status_main() {
    local status=0

    umask 077
    [[ -d "${INSTALL_DIR}" && ! -L "${INSTALL_DIR}" &&
       -f "${APPLIANCE_MARKER}" && ! -L "${APPLIANCE_MARKER}" ]] || \
        backup_die "No safe Vaultwarden Appliance installation was found."
    for command in stat tar gzip sha256sum awk grep sort mktemp rm lsblk findmnt readlink; do
        command_exists "${command}" || backup_die "Required status command '${command}' is unavailable."
    done
    printf 'Vaultwarden Appliance backup status\n\n'
    printf 'Local backups:\n'
    backup_status_directory "${LOCAL_BACKUP_DIR}" || status=1
    printf '\n'
    backup_status_usb || status=1
    printf '\n'
    backup_status_timer
    return "${status}"
}

backup_main() {
    local archive
    local archive_size
    local available_bytes
    local checksum_hash
    local final_status=0
    local required_bytes
    local source_bytes

    umask 077
    trap 'backup_cleanup $?' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    printf 'Vaultwarden Appliance backup\n\n'
    backup_require_environment
    source_bytes=$(backup_source_bytes "${VAULTWARDEN_DATA_DIR}" "${CADDY_DATA_DIR}") || \
        backup_die "Unable to estimate backup source size."
    required_bytes=$(backup_estimated_required_bytes "${source_bytes}") || \
        backup_die "Unable to calculate required local backup space."
    available_bytes=$(backup_available_bytes "${LOCAL_BACKUP_DIR}") || \
        backup_die "Unable to determine available local backup space."
    printf '[INFO] Local required estimate: %s\n' "$(storage_format_bytes "${required_bytes}")"
    printf '[INFO] Local available: %s\n' "$(storage_format_bytes "${available_bytes}")"
    backup_has_sufficient_space "${required_bytes}" "${available_bytes}" || \
        backup_die "Insufficient local free space; older backups were not deleted."
    backup_ok "Local available space checked"

    backup_create_local_generation
    archive=${BACKUP_LOCAL_ARCHIVE}
    backup_verify_generation "${archive}" || backup_die "Installed local backup verification failed."
    archive_size=$(stat -c '%s' "${archive}") || backup_die "Unable to read local archive size."
    checksum_hash=$(awk 'NR == 1 {print $1}' "${archive}.sha256") || \
        backup_die "Unable to read local checksum."
    backup_ok "Local backup generation installed and verified"
    if backup_apply_retention "${LOCAL_BACKUP_DIR}" "${LOCAL_RETENTION_GENERATIONS}" \
        "${archive}" "${BACKUP_WORK_DIR}"; then
        backup_ok "Local retention kept the newest ${LOCAL_RETENTION_GENERATIONS} valid generations"
    else
        backup_error "Local retention failed closed; the new backup and all extra generations were preserved."
        final_status=1
    fi

    printf '\nLocal backup succeeded.\n'
    printf '  File:   %s\n' "${archive}"
    printf '  Size:   %s\n' "$(storage_format_bytes "${archive_size}")"
    printf '  SHA-256: %s\n\n' "${checksum_hash}"
    backup_replicate_usb "${archive}" || final_status=1
    printf '\nSecurity: backups contain sensitive Vaultwarden data and Caddy internal CA private material.\n'
    printf 'Protect local and USB copies appropriately.\n'
    if (( final_status != 0 )); then
        backup_error "The local backup remains valid, but retention or configured USB replication failed."
    fi
    return "${final_status}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    case "${1:-}" in
        '') (( $# == 0 )) || backup_die "Usage: backup [status]"; backup_main ;;
        status) (( $# == 1 )) || backup_die "Usage: backup status"; backup_status_main ;;
        *) backup_die "Usage: backup [status]" ;;
    esac
fi
