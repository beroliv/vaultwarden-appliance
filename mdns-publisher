#!/usr/bin/env bash
# Vaultwarden Appliance mDNS publisher

set -o nounset
set -o pipefail

readonly READY_FILE="/run/vaultwarden-appliance-mdns/ready"
readonly MDNS_HOSTNAME=${1:-}
readonly IPV4_ADDRESS=${2:-}

PUBLISHER_PID=""

cleanup() {
    rm -f -- "${READY_FILE}"
    if [[ -n "${PUBLISHER_PID}" ]] && kill -0 "${PUBLISHER_PID}" 2>/dev/null; then
        kill "${PUBLISHER_PID}" 2>/dev/null || true
        wait "${PUBLISHER_PID}" 2>/dev/null || true
    fi
}

stop_cleanly() {
    trap - HUP INT TERM
    cleanup
    exit 0
}

resolved_ipv4s() {
    /usr/bin/timeout 3 /usr/bin/avahi-resolve-host-name -4 "${MDNS_HOSTNAME}" 2>/dev/null |
        /usr/bin/awk 'NF >= 2 && !seen[$2]++ {print $2}'
}

validate_arguments() {
    local octet
    local -a octets

    [[ "${MDNS_HOSTNAME}" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.local$ ]] || return 1
    [[ "${IPV4_ADDRESS}" =~ ^[0-9]+(\.[0-9]+){3}$ ]] || return 1
    IFS='.' read -r -a octets <<<"${IPV4_ADDRESS}"
    (( ${#octets[@]} == 4 )) || return 1
    for octet in "${octets[@]}"; do
        (( ${#octet} <= 3 )) || return 1
        (( 10#${octet} <= 255 )) || return 1
    done
}

main() {
    local confirmed=0
    local publisher_status=0
    local resolved=""
    local _attempt

    validate_arguments || {
        printf '[FAIL] Invalid mDNS publisher hostname or IPv4 address.\n' >&2
        return 1
    }

    trap stop_cleanly HUP INT TERM
    rm -f -- "${READY_FILE}"

    /usr/bin/avahi-publish-address --no-fail "${MDNS_HOSTNAME}" "${IPV4_ADDRESS}" &
    PUBLISHER_PID=$!

    for _attempt in {1..15}; do
        sleep 1
        if ! kill -0 "${PUBLISHER_PID}" 2>/dev/null; then
            wait "${PUBLISHER_PID}" || publisher_status=$?
            printf '[FAIL] avahi-publish-address exited before publishing %s -> %s (status %d).\n' \
                "${MDNS_HOSTNAME}" "${IPV4_ADDRESS}" "${publisher_status}" >&2
            cleanup
            return 1
        fi

        resolved=$(resolved_ipv4s || true)
        if [[ "${resolved}" == "${IPV4_ADDRESS}" ]]; then
            confirmed=$((confirmed + 1))
        else
            confirmed=0
        fi

        if (( confirmed >= 2 )); then
            printf 'hostname=%s\naddress=%s\n' "${MDNS_HOSTNAME}" "${IPV4_ADDRESS}" > "${READY_FILE}"
            chmod 0644 "${READY_FILE}"
            printf '[ OK ] Published mDNS mapping %s -> %s.\n' "${MDNS_HOSTNAME}" "${IPV4_ADDRESS}"
            break
        fi
    done

    if [[ ! -f "${READY_FILE}" ]]; then
        printf '[FAIL] mDNS mapping %s -> %s did not become ready.\n' \
            "${MDNS_HOSTNAME}" "${IPV4_ADDRESS}" >&2
        [[ -z "${resolved}" ]] || printf 'Resolved IPv4 address(es): %s\n' "${resolved//$'\n'/, }" >&2
        cleanup
        return 1
    fi

    wait "${PUBLISHER_PID}" || publisher_status=$?
    rm -f -- "${READY_FILE}"
    printf '[FAIL] avahi-publish-address stopped unexpectedly (status %d).\n' \
        "${publisher_status}" >&2
    return 1
}

main "$@"
